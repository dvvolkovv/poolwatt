DATABASE_URL=postgresql://poolwatt:CHANGE_ME@127.0.0.1:5432/poolwatt
REDIS_URL=redis://127.0.0.1:6379
NEXTAUTH_URL=https://poolwatt.com
NEXTAUTH_SECRET=CHANGE_ME

# Sign in with Taler ID (https://talerid.io/oauth-guide.html). Register a client
# at https://talerid.io/developers/ with the redirect URI
# <NEXTAUTH_URL>/api/auth/callback/talerid. Hidden in the UI while empty.
TALERID_CLIENT_ID=
TALERID_CLIENT_SECRET=
# Only for tests against another issuer.
TALERID_ISSUER=

# OAuth providers (not wired)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Admin bootstrap. Comma-separated entries with prefixes:
#   email:foo@bar.com
#   telegram:123456789
#   github:octocat
ADMIN_WHITELIST=

# Energy data sources (used in Phase 2)
GRID_REFRESH_SEC=60
WEATHER_API_KEY=
PUBLIC_GRID_API_URL=

# Mapbox (public token, safe for client-side)
NEXT_PUBLIC_MAPBOX_TOKEN=

# Email — our own mail server over SMTP. Required in production:
# verification and password-reset mails fail without it.
# Port 2525 because the production host blocks outbound 25/465/587.
SMTP_HOST=
SMTP_PORT=2525
SMTP_USER=noreply@poolwatt.com
SMTP_PASS=
EMAIL_FROM="Poolwatt <noreply@poolwatt.com>"
EMAIL_REPLY_TO=info@poolwatt.com
# Optional override: when set, mail goes through Resend's HTTPS API instead.
RESEND_API_KEY=

# Address that receives a notification email for every new build request.
# Optional — when unset, the notification is skipped (logged with warn).
# Operator inbox for new listing applications, build requests and contractor
# registrations. Falls back to EMAIL_REPLY_TO when empty.
ADMIN_EMAIL=

# Exchange features that stay shut until something outside the code exists
# (src/lib/exchange/gates.ts).
# "sandbox" lets the local generator invent IBANs; ignored in production.
IBAN_PROVIDER=
# "true" opens kWh transfers. Needs the lawyer's opinion of TZ section 24.4 first.
KWH_TRANSFERS_ENABLED=

# MQTT broker for asset telemetry (ТЗ §4, US-03). Leave empty to disable.
MQTT_URL=
MQTT_USERNAME=
MQTT_PASSWORD=

# Where listing (KYB) documents are stored. Absolute path, outside /public.
LISTING_DOCS_DIR=

# KYB / sanctions screening provider (ТЗ §4, US-02). Empty or "manual"
# means the operator records their own check; any other value turns on the
# automated path.
KYB_PROVIDER=

# Seals the HMAC signing secrets of equipment API keys (ТЗ §15).
# 32 random bytes, base64: openssl rand -base64 32
# Empty means keys are issued without a signing secret and telemetry is
# accepted unsigned — fine for a local run, not for production.
API_KEY_ENC_KEY=

# Day-ahead spot prices from the ENTSO-E Transparency Platform (ТЗ §6, §16.5).
# Request the token at transparency.entsoe.eu. Empty keeps every zone on the
# price the operator sets by hand.
ENTSOE_TOKEN=
