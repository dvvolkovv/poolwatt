DATABASE_URL=postgresql://poolwatt:CHANGE_ME@127.0.0.1:5432/poolwatt
REDIS_URL=redis://127.0.0.1:6379
NEXTAUTH_URL=https://poolwatt.com
NEXTAUTH_SECRET=CHANGE_ME

# OAuth providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Admin bootstrap. Comma-separated entries with prefixes:
#   email:foo@bar.com
#   telegram:123456789
#   github:octocat
ADMIN_WHITELIST=

# Energy data sources (used in Phase 2)
GRID_REFRESH_SEC=60
WEATHER_API_KEY=
PUBLIC_GRID_API_URL=

# Mapbox (public token, safe for client-side)
NEXT_PUBLIC_MAPBOX_TOKEN=

# Email — our own mail server over SMTP. Required in production:
# verification and password-reset mails fail without it.
# Port 2525 because the production host blocks outbound 25/465/587.
SMTP_HOST=
SMTP_PORT=2525
SMTP_USER=noreply@poolwatt.com
SMTP_PASS=
EMAIL_FROM="Poolwatt <noreply@poolwatt.com>"
EMAIL_REPLY_TO=info@poolwatt.com
# Optional override: when set, mail goes through Resend's HTTPS API instead.
RESEND_API_KEY=

# Address that receives a notification email for every new build request.
# Optional — when unset, the notification is skipped (logged with warn).
ADMIN_EMAIL=
