}

// Hub == aggregation point / microgrid / utility partner where producers and buyers meet.
model Hub {
  id               String         @id // e.g. "iberian-grid"
  slug             String         @unique
  name             String
  country          String?
  region           String?
  lat              Float?
  lng              Float?
  logoUrl          String?
  isOperational    Boolean        @default(true)
  yearEstablished  Int?
  capacityKwh      Float // aggregate
  throughput24hKwh Float
  trustScore       Int?
  trustScoreRank   Int?
  url              String?
  watchedBy        HubWatchlist[]
  contracts        Contract[]
  fetchedAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([trustScoreRank])
}

model HubWatchlist {
  userId  String
  hubId   String
  addedAt DateTime @default(now())
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
