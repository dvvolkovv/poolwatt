  buildRequestId String
  buildRequest   BuildRequest @relation("ProducerClaimsOnBR", fields: [buildRequestId], references: [id], onDelete: Cascade)
  producerId     String
  producer       Producer     @relation("ProducerClaimsByProducer", fields: [producerId], references: [id], onDelete: Cascade)

  status  BuildRequestClaimStatus @default(PENDING)
  message String?                 @db.Text

  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  @@unique([buildRequestId, producerId])
  @@index([buildRequestId, status])
  @@index([producerId, status])
}

// ============================================================================
// EXCHANGE CORE — listing, telemetry, token registry, order book, wallet,
// payments. Implements ТЗ §4–§8 and the analyst spec §13–§16, §19, §24.
//
// Numeric precision is fixed by ТЗ §16.1:
//   kWh    Decimal(18, 3) — 1 token = 1 kWh, stored to 0.001
//   price  Decimal(12, 4) — money per kWh
//   money  Decimal(18, 2) — fiat amounts
// Domain logic rounds to these scales via src/lib/exchange/precision.ts.
// ============================================================================

enum CompanyType {
  PRODUCER
  WHOLESALE
  COOPERATIVE
  OPERATOR
}

enum KybStatus {
  PENDING
  APPROVED
  REJECTED
}

// §4 "Проверка KYB, санкционный скрининг". What a single check looked at.
enum ScreeningKind {
  KYB // the company exists, its registration and licences are real
  SANCTIONS // consolidated sanctions and PEP lists
  ADVERSE_MEDIA
}

// §4 — the verdict the operator must have on record before approving.
enum ScreeningResult {
  CLEAR
  HIT
  INCONCLUSIVE
}

// §14: draft → submitted → approved / rejected.
enum ListingApplicationStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum AssetKind {
  SOLAR
  WIND
  BIOGAS
  HYDRO
  STORAGE
  MIXED
}

// §14: test → active after a clean telemetry period + operator approval.
enum AssetStatus {
  DRAFT
  REVIEW
  TEST
  ACTIVE
  SUSPENDED
}

// §14: received → valid / suspicious / rejected.
enum ReadingValidationStatus {
  RECEIVED
  VALID
  SUSPICIOUS
  REJECTED
}

// §14 token lifecycle. ROUTED = handed to the aggregator at interval close.
enum EnergyTokenStatus {
  AVAILABLE
  RESERVED
  STORED
  SOLD
  BURNED
  ROUTED
}

enum OrderSide {
  BUY
  SELL
}

enum OrderType {
  MARKET
  LIMIT
}

enum OrderStatus {
  NEW
  PARTIALLY_FILLED
  FILLED
  CANCELLED
  EXPIRED
  REJECTED
}

// §14: initiated → authorized → captured, with failed / refunded exits.
enum PaymentStatus {
  INITIATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

enum SettlementAccountStatus {
  ACTIVE
  FROZEN
  CLOSED
}

// §24: a transfer can require the recipient to confirm, so it has its own
// lifecycle separate from Trade.
enum TokenTransferStatus {
  CREATED
  CONFIRMED
  CANCELLED
}

// A trading zone — country or grid zone. Carries the market parameters the
// matching engine needs: tick interval, currency, spot reference and the
// price corridor of §16.5.
model GridZone {
  id              String    @id @default(cuid())
  code            String    @unique // "SK", "LT", "UA-CENTRAL"
  country         String // ISO-3166 alpha-2
  name            String
  currency        String    @default("EUR")
  // §6, §16.5 — where the spot reference comes from: null or "manual" means
  // the operator sets it by hand, "entsoe" means the day-ahead feed.
  spotSource      String?
  // The bidding zone at the source, e.g. the EIC code 10YSK-SEPS---K.
  spotAreaCode    String?
  intervalMinutes Int       @default(15) // §18 open question: 15 or 60
  // §16.5 — trade price must stay within ±corridorPct of spotPrice.
  corridorPct     Decimal   @default(20) @db.Decimal(5, 2)
  spotPrice       Decimal?  @db.Decimal(12, 4)
  spotPriceAt     DateTime?
  // §16.4 — where unsold tokens go when an interval closes.
  aggregatorName  String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  assets    Asset[]
  tokens    EnergyToken[]
  wallets   Wallet[]
  orders    Order[]
  trades    Trade[]
  payments  Payment[]
  transfers TokenTransfer[]
  readings  MeterReading[]
  campaigns Campaign[]

  cooperatives         Cooperative[]
  acceptancePoints     AcceptancePoint[]
  spotPrices           ZoneSpotPrice[]
  roamingAsHomeZone    RoamingAgreement[] @relation("RoamingHomeZone")
  roamingAsVisitedZone RoamingAgreement[] @relation("RoamingVisitedZone")
  marketingContents    MarketingContent[]
  chargeSessions       ChargeSession[]
}

// §6, §16.5 — the external spot reference per interval, kept as history.
// The corridor reads the current one; §16.7 (no liquidity on the exchange)
// settles at the one that applied, so an overwritten number is not enough.
model ZoneSpotPrice {
  id            String   @id @default(cuid())
  zoneId        String
  zone          GridZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  intervalStart DateTime
  // EUR per kWh, converted from the source's EUR per MWh.
  price         Decimal  @db.Decimal(12, 4)
  currency      String   @default("EUR")
  source        String
  fetchedAt     DateTime @default(now())

  @@unique([zoneId, intervalStart, source])
  @@index([zoneId, intervalStart])
}

// §13 Company — the legal entity that lists on the platform. Distinct from
// Contractor (a build-services vendor) and Producer (a public catalogue card).
model Company {
  id            String      @id @default(cuid())
  legalName     String
  country       String // ISO-3166 alpha-2
  regNumber     String
  vatNumber     String?
  type          CompanyType
  kybStatus     KybStatus   @default(PENDING)
  // Sanctions screening result, filled by the operator during review.
  screeningNote String?     @db.Text
  website       String?
  contactName   String?
  contactEmail  String?
  contactPhone  String?
  ownerUserId   String?
  owner         User?       @relation("CompanyOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  applications      ListingApplication[]
  screenings        ScreeningCheck[]
  assets            Asset[]
  workOrders        WorkOrder[]
  settlementAccount SettlementAccount?
  feePlanId         String?
  feePlan           FeePlan?             @relation(fields: [feePlanId], references: [id], onDelete: SetNull)
  cooperative       Cooperative?
  pricingRules      PricingRule[]
  partnerPlan       PartnerPlan?

  @@unique([country, regNumber])
  @@index([type, kybStatus])
}

// §13 / US-01, US-02. Documents are stored as a JSON array of
// { name, url, bytes, mime } — upload target is out of scope for this slice.
model ListingApplication {
  id              String                   @id @default(cuid())
  companyId       String
  company         Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  status          ListingApplicationStatus @default(DRAFT)
  documents       Json                     @default("[]")
  reviewerId      String?
  reviewer        User?                    @relation("ListingReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  decisionComment String?                  @db.Text
  submittedAt     DateTime?
  decidedAt       DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@index([status, submittedAt])
  @@index([companyId])
}

// §4 / US-02 — one KYB or sanctions check on a company.
//
// Who ran the check matters as much as the verdict: an operator typing in what
// the national register and the EU consolidated list said is a different
// record from an automated provider's answer, and a regulator will ask which
// it was. `provider` says so, `evidence` keeps the references, and the row is
// immutable once written — a re-check is a new row.
model ScreeningCheck {
  id          String          @id @default(cuid())
  companyId   String
  company     Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  kind        ScreeningKind
  result      ScreeningResult
  /// "manual" while no provider is contracted; otherwise the provider's name.
  provider    String
  /// Registry extract numbers, list names, search URLs — what was looked at.
  evidence    String?         @db.Text
  /// Matches the check turned up, as the provider reported them.
  matches     Json            @default("[]")
  checkedById String?
  checkedBy   User?           @relation("ScreeningChecker", fields: [checkedById], references: [id], onDelete: SetNull)
  checkedAt   DateTime        @default(now())

  @@index([companyId, kind, checkedAt])
}

// §13 Asset — a generation object or a storage unit (powerbank).
model Asset {
  id               String      @id @default(cuid())
  companyId        String
  company          Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  kind             AssetKind
  name             String
  capacityKw       Decimal     @db.Decimal(12, 3)
  storageKwh       Decimal?    @db.Decimal(12, 3) // capacity, STORAGE/MIXED only
  storedKwh        Decimal     @default(0) @db.Decimal(18, 3) // current charge
  address          String?
  latitude         Float?
  longitude        Float?
  gridZoneId       String
  gridZone         GridZone    @relation(fields: [gridZoneId], references: [id])
  meterId          String?     @unique
  status           AssetStatus @default(DRAFT)
  goCertificateRef String? // guarantee of origin registry reference

  // §4: token minting stays off until documents pass AND telemetry has run
  // clean for the probation window. telemetryCleanSince is reset by any
  // SUSPICIOUS/REJECTED reading.
  telemetryCleanSince DateTime?
  activatedAt         DateTime?
  suspendedReason     String?

  // §30 "Правила продажи" — the dispatcher splits each validated interval.
  minSalePrice      Decimal? @db.Decimal(12, 4)
  // §30 "резерв на случай отключения (минимальный уровень заряда)": the share
  // of a storage asset's capacity that is never offered to the market.
  reserveSocPct     Int      @default(0)
  shareToMarketPct  Int      @default(100)
  shareToStoragePct Int      @default(0)
  shareToSelfPct    Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  apiKeys    AssetApiKey[]
  readings   MeterReading[]
  alerts     AssetAlert[]
  workOrders WorkOrder[]
  tokens     EnergyToken[]

  @@index([companyId, status])
  @@index([gridZoneId, status])
}

// Telemetry credential for one asset. Mirrors ChargerOperatorApiKey: the
// plaintext is shown once, only the SHA-256 is stored.
model AssetApiKey {
  id               String    @id @default(cuid())
  assetId          String
  asset            Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  label            String?
  tokenHash        String    @unique
  prefix           String // first chars of the plaintext, for display
  // §15 HMAC signing secret, sealed with API_KEY_ENC_KEY (src/lib/crypto-box.ts).
  // Null on keys issued before signing existed, or where no key is configured:
  // those keep working unsigned until they are rotated.
  signingSecretEnc String?
  signingSecretIv  String?
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime?
  revokedAt        DateTime?

  @@index([assetId])
}

// §30 "Уведомления" / US-29 — an alarm on one asset. Append-only while open:
// one row per unresolved condition, so a flapping link does not mail the
// engineer every minute.
model AssetAlert {
  id             String         @id @default(cuid())
  assetId        String
  asset          Asset          @relation(fields: [assetId], references: [id], onDelete: Cascade)
  kind           AssetAlertKind
  note           String
  occurredAt     DateTime       @default(now())
  // When the engineer was told. Null means the notification still owes.
  notifiedAt     DateTime?
  resolvedAt     DateTime?
  resolvedBy     String?
  resolutionNote String?

  workOrder WorkOrder? @relation("AlertWorkOrder")

  @@index([assetId, resolvedAt])
  @@index([resolvedAt, notifiedAt])
}

enum AssetAlertKind {
  TELEMETRY_ANOMALY // a reading the validator refused or flagged
  LINK_LOST // nothing heard from the equipment for three intervals
  SUSPENDED // the operator stopped the asset
}

// §5 / §13. One reading per (asset, interval) — this uniqueness is what
// guarantees §16.2 "one MeterReading → exactly one mint".
model MeterReading {
  id               String                  @id @default(cuid())
  assetId          String
  asset            Asset                   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  zoneId           String
  zone             GridZone                @relation(fields: [zoneId], references: [id])
  intervalStart    DateTime
  intervalEnd      DateTime
  energyKwh        Decimal                 @db.Decimal(18, 3)
  source           String // "rest" | "mqtt" | "manual"
  validationStatus ReadingValidationStatus @default(RECEIVED)
  validationNote   String?
  receivedAt       DateTime                @default(now())
  mintedAt         DateTime?

  token EnergyToken?

  @@unique([assetId, intervalStart])
  @@index([assetId, intervalStart])
  @@index([validationStatus])
}

// §5 / §13 Token — a batch of kWh. A batch splits when a trade consumes part
// of it, so amountKwh is always the live, unconsumed size of the batch.
model EnergyToken {
  id               String            @id @default(cuid())
  assetId          String
  asset            Asset             @relation(fields: [assetId], references: [id], onDelete: Cascade)
  zoneId           String
  zone             GridZone          @relation(fields: [zoneId], references: [id])
  // Set on the batch minted directly from a reading; null on split children
  // and on batches created by storage round-trips.
  readingId        String?           @unique
  reading          MeterReading?     @relation(fields: [readingId], references: [id], onDelete: SetNull)
  parentId         String?
  parent           EnergyToken?      @relation("TokenSplit", fields: [parentId], references: [id], onDelete: SetNull)
  children         EnergyToken[]     @relation("TokenSplit")
  intervalStart    DateTime
  amountKwh        Decimal           @db.Decimal(18, 3)
  status           EnergyTokenStatus @default(AVAILABLE)
  goCertificateRef String?
  ownerWalletId    String?
  ownerWallet      Wallet?           @relation(fields: [ownerWalletId], references: [id], onDelete: SetNull)
  // The trade that moved this batch to its buyer (§13). Set at settlement, so
  // a producer's revenue can be attributed to the asset that generated it
  // (§30 "доход в деньгах и средняя цена продажи") and a sold batch carries
  // its own grounds for §16.11.
  soldTradeId      String?
  soldTrade        Trade?            @relation("TradeTokens", fields: [soldTradeId], references: [id], onDelete: SetNull)
  // §16.4 routing outcome, when status = ROUTED or STORED.
  routedTo         String?
  storedInAssetId  String?
  mintedAt         DateTime          @default(now())
  burnedAt         DateTime?

  @@index([assetId, intervalStart])
  @@index([zoneId, status, intervalStart])
  @@index([ownerWalletId, status])
  @@index([soldTradeId])
}

// §7 Wallet — one per (user, zone): kWh tokens plus a fiat balance.
model Wallet {
  id           String   @id @default(cuid())
  ownerUserId  String
  owner        User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  zoneId       String
  zone         GridZone @relation(fields: [zoneId], references: [id])
  kwhBalance   Decimal  @default(0) @db.Decimal(18, 3)
  fiatBalance  Decimal  @default(0) @db.Decimal(18, 2)
  // Funds held against open BUY orders (§12 US-06 "резерв средств").
  reservedFiat Decimal  @default(0) @db.Decimal(18, 2)
  currency     String   @default("EUR")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tokens            EnergyToken[]
  orders            Order[]
  payments          Payment[]
  reservations      Reservation[]
  outgoingTransfers TokenTransfer[] @relation("TransferFrom")
  incomingTransfers TokenTransfer[] @relation("TransferTo")
  chargeSessions    ChargeSession[]
  refunds           PaymentRefund[]

  @@unique([ownerUserId, zoneId])
  @@index([zoneId])
}

// §6 / §13 Order. MARKET orders never rest in the book; only LIMIT orders do.
model Order {
  id             String      @id @default(cuid())
  walletId       String
  wallet         Wallet      @relation(fields: [walletId], references: [id], onDelete: Cascade)
  zoneId         String
  zone           GridZone    @relation(fields: [zoneId], references: [id])
  side           OrderSide
  type           OrderType
  intervalStart  DateTime? // null = any interval (spot / retail buy)
  amountKwh      Decimal     @db.Decimal(18, 3)
  filledKwh      Decimal     @default(0) @db.Decimal(18, 3)
  limitPrice     Decimal?    @db.Decimal(12, 4)
  avgPrice       Decimal?    @db.Decimal(12, 4)
  status         OrderStatus @default(NEW)
  reservedFiat   Decimal     @default(0) @db.Decimal(18, 2)
  rejectReason   String?
  // §15: every POST carries an idempotency key.
  idempotencyKey String?     @unique
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  cancelledAt    DateTime?

  buyTrades  Trade[]  @relation("BuyOrder")
  sellTrades Trade[]  @relation("SellOrder")
  payment    Payment? @relation("PaymentOrder")

  // The resting-book query: open orders of one side, in a zone and interval.
  @@index([zoneId, intervalStart, side, status, limitPrice, createdAt])
  @@index([walletId, status])
}

// §13 Trade — one fill. Fees are charged to both sides per §16.8.
model Trade {
  id          String   @id @default(cuid())
  zoneId      String
  zone        GridZone @relation(fields: [zoneId], references: [id])
  buyOrderId  String
  buyOrder    Order    @relation("BuyOrder", fields: [buyOrderId], references: [id], onDelete: Cascade)
  sellOrderId String
  sellOrder   Order    @relation("SellOrder", fields: [sellOrderId], references: [id], onDelete: Cascade)
  amountKwh   Decimal  @db.Decimal(18, 3)
  price       Decimal  @db.Decimal(12, 4)
  buyerFee    Decimal  @default(0) @db.Decimal(18, 2)
  sellerFee   Decimal  @default(0) @db.Decimal(18, 2)
  executedAt  DateTime @default(now())

  receipt Receipt?
  tokens  EnergyToken[] @relation("TradeTokens")

  @@index([zoneId, executedAt])
  @@index([buyOrderId])
  @@index([sellOrderId])
}

// §8 Payment — the charge waterfall: balance first, shortfall bought at market.
model Payment {
  id                   String           @id @default(cuid())
  walletId             String
  wallet               Wallet           @relation(fields: [walletId], references: [id], onDelete: Cascade)
  zoneId               String
  zone                 GridZone         @relation(fields: [zoneId], references: [id])
  // Free-form equipment identifier the station reports.
  chargePointId        String?
  // §46 "Пункт, разъём, дата и время начала и конца зарядки" — the real
  // session, when it happened at one of our points. Null for a charge
  // somewhere else: the receipt is still issued, just without branding.
  pointId              String?
  point                AcceptancePoint? @relation(fields: [pointId], references: [id], onDelete: SetNull)
  connectorId          String?
  connector            PointConnector?  @relation(fields: [connectorId], references: [id], onDelete: SetNull)
  startedAt            DateTime?
  endedAt              DateTime?
  requestedKwh         Decimal          @db.Decimal(18, 3)
  kwhFromBalance       Decimal          @default(0) @db.Decimal(18, 3)
  // §8, US-11 — kWh a clearing partner delivered in this zone against the
  // driver's balance in another one.
  kwhFromRoaming       Decimal          @default(0) @db.Decimal(18, 3)
  kwhBought            Decimal          @default(0) @db.Decimal(18, 3)
  // Authorized with the §16.6 buffer; captured at the real execution price.
  authorizedFiat       Decimal          @default(0) @db.Decimal(18, 2)
  amountFiat           Decimal          @default(0) @db.Decimal(18, 2)
  status               PaymentStatus    @default(INITIATED)
  failureReason        String?
  cardId               String?
  marketOrderId        String?          @unique
  marketOrder          Order?           @relation("PaymentOrder", fields: [marketOrderId], references: [id], onDelete: SetNull)
  idempotencyKey       String?          @unique
  createdAt            DateTime         @default(now())
  authorizedAt         DateTime?
  capturedAt           DateTime?
  // §45 US-41 "начисление в течение минуты после завершения зарядки". Set
  // once the campaigns of this session's network have been looked at; the
  // worker sweeps whatever the inline attempt missed.
  campaignsEvaluatedAt DateTime?
  // §54 — the version of the point's tariff this session was priced under, so
  // an issued receipt does not change when the partner edits the price.
  tariffVersion        Int?

  receipt           Receipt?
  roamingSettlement RoamingSettlement?
  promoGrants       PromoGrant[]
  chargeSession     ChargeSession?
  // §51 — заявки об этом сеансе и возвраты по ним.
  tickets           Ticket[]           @relation("TicketPayment")
  refunds           PaymentRefund[]

  @@index([walletId, createdAt])
  @@index([status])
  @@index([pointId, capturedAt])
}

// §16.6 — у зарядки два момента: "сумма авторизуется с запасом Y %" в начале
// и "списывается по факту" в конце. Между ними живёт сеанс, ход которого
// водитель видит на экране (§22.9, US-20). Без этой записи зарядка была одним
// неделимым вызовом, и показать её ход было нечем.
enum ChargeSessionStatus {
  AUTHORIZED
  ACTIVE
  COMPLETED
  CANCELLED
  EXPIRED
  FAILED
}

model ChargeSession {
  id            String          @id @default(cuid())
  userId        String
  user          User            @relation("ChargeSessionDriver", fields: [userId], references: [id], onDelete: Cascade)
  walletId      String
  wallet        Wallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)
  zoneId        String
  zone          GridZone        @relation(fields: [zoneId], references: [id])
  pointId       String
  point         AcceptancePoint @relation(fields: [pointId], references: [id], onDelete: Cascade)
  connectorId   String
  connector     PointConnector  @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  // §32.5 — какую бронь закрыл этот сеанс.
  reservationId String?         @unique
  reservation   Reservation?    @relation(fields: [reservationId], references: [id], onDelete: SetNull)

  status         ChargeSessionStatus @default(AUTHORIZED)
  plannedKwh     Decimal             @db.Decimal(18, 3)
  deliveredKwh   Decimal             @default(0) @db.Decimal(18, 3)
  // Резерв под сеанс: тот же механизм, что держит средства под заявкой.
  authorizedFiat Decimal             @default(0) @db.Decimal(18, 2)
  currency       String              @default("EUR")
  // Снимок ChargePlan на момент согласия водителя — чтобы спор "мне считали
  // другое" разбирался по тому, что он видел.
  quote          Json                @default("{}")
  tariffVersion  Int?

  paymentId      String?  @unique
  payment        Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  idempotencyKey String?  @unique

  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  lastMeterAt DateTime?
  endedAt     DateTime?
  closeReason String?

  ticks ChargeSessionTick[]

  @@index([userId, status])
  @@index([connectorId, status])
  @@index([status, lastMeterAt])
}

// Ход зарядки и доказательство в споре "списали больше, чем я взял".
model ChargeSessionTick {
  id        String        @id @default(cuid())
  sessionId String
  session   ChargeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  at        DateTime      @default(now())
  kwhTotal  Decimal       @db.Decimal(18, 3)
  powerKw   Decimal?      @db.Decimal(8, 2)

  @@index([sessionId, at])
}

// §13 / §46 Receipt — issued for a payment or a trade; lists the burned batches.
model Receipt {
  id             String       @id @default(cuid())
  // Poolwatt's own document number, PW-<year>-<6 digits>, from
  // receipt_number_seq. Not a tax invoice number: numbering under the law of
  // the point's country is part of the tax opinion the owner still owes.
  number         String?      @unique
  // §46 "QR-код для проверки чека" — what the QR carries. Unguessable,
  // because anyone can photograph a printed receipt.
  verifyCode     String?      @unique
  paymentId      String?      @unique
  payment        Payment?     @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  tradeId        String?      @unique
  trade          Trade?       @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  // §35 US-33 — a no-show leaves a receipt like any other charge.
  reservationId  String?      @unique
  reservation    Reservation? @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  burnedTokenIds String[]
  totalKwh       Decimal      @default(0) @db.Decimal(18, 3)
  totalFiat      Decimal      @default(0) @db.Decimal(18, 2)
  currency       String       @default("EUR")
  // §46 "Состав чека" — per-line detail kept verbatim for accounting export.
  breakdown      Json         @default("{}")

  // §46 — the document as it was issued. Until this column existed the
  // receipt was rebuilt from live rows at every read, so a partner editing
  // their VAT rate today silently rewrote every receipt they ever issued.
  // A document is a document: it is frozen here, and changing it goes
  // through a claim and a correction (`ReceiptCorrection`).
  document        Json?
  documentVersion Int   @default(1)

  // §46 "исправление по регламенту" — the receipt this one corrects. The
  // original stays as it was and points here through the back relation, so
  // both versions are readable forever.
  correctsReceiptId String?  @unique
  corrects          Receipt? @relation("ReceiptCorrectionChain", fields: [correctsReceiptId], references: [id], onDelete: Cascade)
  correctedBy       Receipt? @relation("ReceiptCorrectionChain")

  claims      ReceiptClaim[]
  corrections ReceiptCorrection[] @relation("CorrectionOfReceipt")
  issuedAs    ReceiptCorrection[] @relation("CorrectionIssuedReceipt")

  issuedAt         DateTime  @default(now())
  // §46 "Доставка чека". Null means nobody has been told yet, and the worker
  // sweep will pick it up — that is what makes "within a minute" true even
  // when the inline attempt fails.
  deliveredAt      DateTime?
  deliveryChannels String[]  @default([])
  deliveryError    String?

  @@index([issuedAt])
  @@index([deliveredAt])
}

// §46 — "Ошибочный чек или счёт бухгалтер возвращает в поддержку Poolwatt".
//
// The accountant's side of the regulation: what they say is wrong, and what
// support did about it. One open claim per receipt, as a rule of the database
// rather than a check two clicks can both pass.
model ReceiptClaim {
  id         String           @id @default(cuid())
  receiptId  String
  receipt    Receipt          @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  // Denormalised for the queue and for scope checks (§47).
  operatorId String?
  operator   ChargerOperator? @relation(fields: [operatorId], references: [id], onDelete: SetNull)

  claimedById String
  claimedBy   User               @relation("ReceiptClaimant", fields: [claimedById], references: [id], onDelete: Cascade)
  reason      ReceiptClaimReason
  comment     String             @db.Text

  status       ReceiptClaimStatus @default(OPEN)
  resolvedById String?
  resolvedBy   User?              @relation("ReceiptClaimResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  // Mandatory when a claim is refused: a refusal with no reason is not an
  // answer an accountant can act on.
  resolution   String?            @db.Text
  resolvedAt   DateTime?

  createdAt DateTime @default(now())

  corrections ReceiptCorrection[]

  // One live claim per receipt; a resolved one carries the key null, which
  // Postgres counts as distinct, so the next claim is allowed.
  openKey String?

  @@unique([receiptId, openKey])
  @@index([status, createdAt])
  @@index([operatorId, status])
}

// §46 "журнал изменений" — append-only. One row per correction, naming every
// field that moved and both documents.
model ReceiptCorrection {
  id      String        @id @default(cuid())
  claimId String?
  claim   ReceiptClaim? @relation(fields: [claimId], references: [id], onDelete: SetNull)

  receiptId       String
  receipt         Receipt @relation("CorrectionOfReceipt", fields: [receiptId], references: [id], onDelete: Cascade)
  // The version issued in its place.
  issuedReceiptId String
  issuedReceipt   Receipt @relation("CorrectionIssuedReceipt", fields: [issuedReceiptId], references: [id], onDelete: Cascade)

  correctedById String
  correctedBy   User     @relation("ReceiptCorrector", fields: [correctedById], references: [id], onDelete: Cascade)
  /// [{ field, before, after }] — what the regulation allowed to change.
  changes       Json
  note          String?  @db.Text
  createdAt     DateTime @default(now())

  @@index([receiptId])
  @@index([createdAt])
}

enum ReceiptClaimReason {
  // Wrong requisites of the network on the document.
  REQUISITES
  // Wrong VAT rate or tax note: the gross stays, its split changes.
  VAT
  // Wrong point name, address or connector label.
  SESSION_DETAILS
  // Wrong amount or volume — a refund, which needs the payment provider.
  AMOUNTS
  OTHER
}

enum ReceiptClaimStatus {
  OPEN
  CORRECTED
  REJECTED
}

// §46 "Бухгалтерия партнёра" — what a charging network says about itself on
// its own receipts, and the account numbers its accountant's software needs.
//
// None of this is ours to invent: a VAT rate or a Sachkonto we made up is a
// wrong tax document. Empty means the receipt prints "VAT not stated" and the
// DATEV / BMD export refuses to run.
model OperatorAccounting {
  id         String          @id @default(cuid())
  operatorId String          @unique
  operator   ChargerOperator @relation(fields: [operatorId], references: [id], onDelete: Cascade)

  // §46 item 1 — the requisites printed under the network's logo.
  legalName   String?
  regNumber   String?
  vatNumber   String?
  addressLine String?
  city        String?
  country     String? // ISO-3166 alpha-2
  // §46 item 7. Percent, VAT-inclusive prices (EU retail convention).
  vatRatePct  Decimal? @db.Decimal(5, 2)
  taxNote     String?  @db.Text

  // DATEV EXTF Buchungsstapel and BMD NTCS need these; no defaults.
  datevConsultantNo String?
  datevClientNo     String?
  revenueAccount    String?
  counterAccount    String?
  fiscalYearStart   Int?    @default(1) // month, 1–12
  bmdClientNo       String?

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

// §19 US-13 — personal IBAN opened after listing approval. Named
// SettlementAccount because `Account` is taken by the Auth.js adapter.
model SettlementAccount {
  id        String                  @id @default(cuid())
  companyId String?                 @unique
  company   Company?                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String?                 @unique
  user      User?                   @relation("UserSettlementAccount", fields: [userId], references: [id], onDelete: Cascade)
  iban      String                  @unique
  bic       String?
  currency  String                  @default("EUR")
  balance   Decimal                 @default(0) @db.Decimal(18, 2)
  status    SettlementAccountStatus @default(ACTIVE)
  openedAt  DateTime                @default(now())

  entries SettlementEntry[]
}

// Statement line for GET /v1/accounts/{id}/statement.
model SettlementEntry {
  id          String            @id @default(cuid())
  accountId   String
  account     SettlementAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  amount      Decimal           @db.Decimal(18, 2) // signed
  currency    String            @default("EUR")
  description String
  reference   String? // trade / payment / payout id
  bookedAt    DateTime          @default(now())

  @@index([accountId, bookedAt])
}

// §24 — kWh handoff between members inside one zone.
model TokenTransfer {
  id             String              @id @default(cuid())
  zoneId         String
  zone           GridZone            @relation(fields: [zoneId], references: [id])
  fromWalletId   String
  fromWallet     Wallet              @relation("TransferFrom", fields: [fromWalletId], references: [id], onDelete: Cascade)
  toWalletId     String
  toWallet       Wallet              @relation("TransferTo", fields: [toWalletId], references: [id], onDelete: Cascade)
  amountKwh      Decimal             @db.Decimal(18, 3)
  note           String?
  status         TokenTransferStatus @default(CONFIRMED)
  // §15, same second line of defence as Order and Payment carry.
  idempotencyKey String?             @unique
  createdAt      DateTime            @default(now())
  confirmedAt    DateTime?
  cancelledAt    DateTime?

  @@index([fromWalletId, createdAt])
  @@index([toWalletId, createdAt])
}

// §16.8 / §53 — platform commission, configured per participant type.
model FeePlan {
  id              String       @id @default(cuid())
  name            String       @unique
  participantType CompanyType?
  tradeFeePct     Decimal      @default(1) @db.Decimal(5, 2)
  chargeFeePct    Decimal      @default(2) @db.Decimal(5, 2)
  isDefault       Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  companies Company[]
}

// §25 «Вход по биометрии, подтверждение платежей по SCA (PSD2)».
//
// Биометрия у нас — WebAuthn, а не плагин: плагин отдаёт веб-слою булево
// «отпечаток совпал», и этому булеву нечем доверять — его выставляет тот же
// код, который его и проверяет. SCA — это доказательство, которое проверяет
// сторона, двигающая деньги, то есть сервер. Приватного ключа здесь нет и
// быть не может: он не выходит из защищённого элемента телефона.
model DeviceKey {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId String    @unique
  publicKey    Bytes
  // Счётчик подписей аутентификатора: он идёт только вперёд, и это защита от
  // повтора украденного ответа.
  counter      BigInt    @default(0)
  transports   String[]
  name         String?
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  @@index([userId])
}

// Одноразовый вызов. Живёт в базе, а не в сессии: сессия Auth.js — это
// подписанная cookie, её нельзя «съесть» на сервере, а одноразовость вызова
// и есть защита от повтора.
model WebAuthnChallenge {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge String    @unique
  // "register" | "transfer"
  purpose   String
  createdAt DateTime  @default(now())
  usedAt    DateTime?

  @@index([userId, purpose])
  @@index([createdAt])
}

// §16.11 — generic audit trail for every balance and status change.
// AdminAuditLog stays as-is for the moderation cabinet; this one is written
// by the exchange services and keyed by entity rather than by actor.
model AuditLog {
  id       String   @id @default(cuid())
  actor    String // user id, "system", or "asset:<id>"
  entity   String // "Order", "Wallet", "EnergyToken", …
  entityId String
  action   String
  before   Json?
  after    Json?
  at       DateTime @default(now())

  @@index([entity, entityId, at])
  @@index([at])
}

// ---------------------------------------------------------------------------
// Cooperatives and roaming — ТЗ §7, §8 "Роуминг", §16.10, §24, US-10/11/21.
// ---------------------------------------------------------------------------

// §24.1 — only a KYC-verified member may use or sell received kWh, so
// membership carries its own status instead of relying on the Company KYB.
enum CoopMemberStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum CoopVoteStatus {
  OPEN
  CLOSED
}

// §2 "Кооператив — владелец накопителей (пауэрбанков)". The legal entity is a
// Company of type COOPERATIVE; this model adds the membership, income and
// governance layer on top of it.
model Cooperative {
  id        String   @id @default(cuid())
  companyId String   @unique
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  zoneId    String
  zone      GridZone @relation(fields: [zoneId], references: [id])
  name      String
  // Shares are issued, not derived: a member's stake does not change when
  // another member joins.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members CoopMember[]
  payouts CoopPayout[]
  votes   CoopVote[]

  @@index([zoneId])
}

// US-10 — "количество паёв, доход за период, история выплат".
model CoopMember {
  id            String           @id @default(cuid())
  coopId        String
  coop          Cooperative      @relation(fields: [coopId], references: [id], onDelete: Cascade)
  userId        String
  user          User             @relation("CoopMembership", fields: [userId], references: [id], onDelete: Cascade)
  shares        Int              @default(0)
  status        CoopMemberStatus @default(PENDING)
  kycVerifiedAt DateTime?
  joinedAt      DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  allocations CoopPayoutAllocation[]
  ballots     CoopBallot[]

  @@unique([coopId, userId])
  @@index([coopId, status])
}

// §16.10 — one income period, split pro rata by shares. The split is stored
// rather than recomputed so a later share change cannot rewrite history.
model CoopPayout {
  id           String      @id @default(cuid())
  coopId       String
  coop         Cooperative @relation(fields: [coopId], references: [id], onDelete: Cascade)
  periodStart  DateTime
  periodEnd    DateTime
  incomeAmount Decimal     @db.Decimal(18, 2)
  currency     String      @default("EUR")
  totalShares  Int
  note         String?
  createdAt    DateTime    @default(now())

  allocations CoopPayoutAllocation[]

  @@unique([coopId, periodStart, periodEnd])
  @@index([coopId, periodStart])
}

model CoopPayoutAllocation {
  id       String     @id @default(cuid())
  payoutId String
  payout   CoopPayout @relation(fields: [payoutId], references: [id], onDelete: Cascade)
  memberId String
  member   CoopMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  shares   Int
  amount   Decimal    @db.Decimal(18, 2)
  paidAt   DateTime?

  @@unique([payoutId, memberId])
  @@index([memberId])
}

// US-21 — "один член, один голос; результаты видны после закрытия голосования".
model CoopVote {
  id        String         @id @default(cuid())
  coopId    String
  coop      Cooperative    @relation(fields: [coopId], references: [id], onDelete: Cascade)
  question  String
  options   String[]
  status    CoopVoteStatus @default(OPEN)
  opensAt   DateTime       @default(now())
  closesAt  DateTime
  closedAt  DateTime?
  // Filled on close; null means a tie or no ballots.
  winner    String?
  createdAt DateTime       @default(now())

  ballots CoopBallot[]

  @@index([coopId, status])
}

// The unique constraint is the "one member, one vote" rule in the schema:
// changing a vote updates the row, it never adds one.
model CoopBallot {
  id        String     @id @default(cuid())
  voteId    String
  vote      CoopVote   @relation(fields: [voteId], references: [id], onDelete: Cascade)
  memberId  String
  member    CoopMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  option    String
  castAt    DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([voteId, memberId])
}

// §8 "Роуминг" — the clearing corridor between two zones. Directional: the
// partner's fee for spending SK-bought kWh in LT need not match the reverse.
model RoamingAgreement {
  id            String   @id @default(cuid())
  homeZoneId    String
  homeZone      GridZone @relation("RoamingHomeZone", fields: [homeZoneId], references: [id], onDelete: Cascade)
  visitedZoneId String
  visitedZone   GridZone @relation("RoamingVisitedZone", fields: [visitedZoneId], references: [id], onDelete: Cascade)
  partnerName   String
  feePct        Decimal  @default(0) @db.Decimal(5, 2)
  enabled       Boolean  @default(true)
  // §24.2 — AML limit per user per day, null = no cap configured.
  dailyLimitKwh Decimal? @db.Decimal(18, 3)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  settlements RoamingSettlement[]

  @@unique([homeZoneId, visitedZoneId])
  @@index([visitedZoneId])
}

// §8 "клиринговый сервис закрывает разницу между зонами через взаимозачёт с
// партнёрами", US-11. One row per roaming session: what the partner delivered
// abroad, what was burned at home for it, and the rate it was converted at.
// This is the ledger the netting is done from — nothing else records that a
// session crossed a border.
model RoamingSettlement {
  id             String                  @id @default(cuid())
  agreementId    String
  agreement      RoamingAgreement        @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  userId         String
  user           User                    @relation("RoamingDriver", fields: [userId], references: [id], onDelete: Cascade)
  // Unique: a replayed Idempotency-Key must not produce a second claim.
  paymentId      String?                 @unique
  payment        Payment?                @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  // Visited-zone kWh the clearing partner delivered.
  deliveredKwh   Decimal                 @db.Decimal(18, 3)
  // Home-zone kWh burned for them, the corridor fee included.
  debitedKwh     Decimal                 @db.Decimal(18, 3)
  feeKwh         Decimal                 @default(0) @db.Decimal(18, 3)
  // The rate of this session, kept so a later price move cannot rewrite it.
  conversionRate Decimal                 @db.Decimal(12, 4)
  burnedTokenIds String[]
  status         RoamingSettlementStatus @default(OPEN)
  nettedAt       DateTime?
  // Whatever closed the period outside the system: a payment reference, an
  // invoice number. The operator writes it; we never invent it.
  nettedRef      String?
  createdAt      DateTime                @default(now())

  @@index([agreementId, status])
  @@index([userId, agreementId, createdAt])
}

enum RoamingSettlementStatus {
  OPEN
  NETTED
}

// §30, US-27 — "владелец сам выбирает, какие виджеты видеть … сохраняет
// несколько раскладок". A layout belongs to the person, not to one asset:
// §30 asks for "Утро", "Финансы", "Техника", not for the same work again on
// every station. `widgets` is the §30 layout and widget list in one field —
// an array of { key, size }, validated by src/lib/dashboard/widgets.ts.
model Dashboard {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("DashboardOwner", fields: [userId], references: [id], onDelete: Cascade)
  name      String
  widgets   Json
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId, isDefault])
}

// §15 — "Все POST-запросы с ключом идемпотентности". One row per
// (endpoint, caller, key): the stored response is replayed verbatim, so a
// retried payment or order cannot become a second one. `status = 0` marks a
// request still in flight; see src/lib/exchange/idempotency.ts.
model IdempotencyRecord {
  id          String    @id @default(cuid())
  endpoint    String
  key         String
  // The caller: user id for session endpoints, api key id for equipment.
  userKey     String
  requestHash String
  status      Int       @default(0)
  response    Json      @default("{}")
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@unique([endpoint, userKey, key])
  @@index([createdAt])
}

// §16.11 — "реестр токенов сверяется с данными сети раз в сутки". One row per
// run, so the operator can see that the check ran at all, and what it found.
// Drifts are never repaired automatically: each one is a bug upstream.
model ReconciliationRun {
  id         String    @id @default(cuid())
  scope      String    @default("daily")
  windowFrom DateTime
  windowTo   DateTime
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  // Per check: how much was compared and every disagreement found.
  checks     Json      @default("[]")
  driftCount Int       @default(0)
  ok         Boolean   @default(true)

  @@index([startedAt])
}

// ---------------------------------------------------------------------------
// §41 "Контент карточки и навигатора" / US-40. A partner's own marketing in
// the cards of their own points: a banner, a video, a gallery, a promotion, a
// news line, a link. Moderated by the Poolwatt operator before it is public,
// and shown only inside its own schedule.
// ---------------------------------------------------------------------------

model MarketingContent {
  id         String          @id @default(cuid())
  operatorId String
  operator   ChargerOperator @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  // §41 "в карточках своих пунктов" — empty means the whole network.
  pointIds   String[]        @default([])

  type    MarketingContentType
  title   String
  body    String?              @db.Text
  linkUrl String?

  // §41 "Где показывается". Free strings over a closed vocabulary, the same
  // choice `AcceptancePoint.paymentMethods` makes: nothing ever queries one
  // placement alone.
  placements String[]          @default([])
  audience   MarketingAudience @default(ALL)

  // §41 "Таргетинг … по зоне и радиусу".
  zoneId   String?
  zone     GridZone? @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  radiusKm Int?

  // §41 "Расписание: дата начала и конца, дни недели, часы показа".
  // `weekdays` holds 0 (Sunday) … 6; empty means every day. The hour window
  // is half-open and may cross midnight (22 → 6).
  startsAt DateTime?
  endsAt   DateTime?
  weekdays Int[]     @default([])
  hourFrom Int?
  hourTo   Int?

  // §41 "Модерация оператором Poolwatt перед публикацией" — the same trail a
  // point card leaves.
  status       MarketingStatus @default(DRAFT)
  submittedAt  DateTime?
  reviewedAt   DateTime?
  reviewedById String?
  reviewNote   String?         @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assets MarketingAsset[]
  events ContentEvent[]

  @@index([operatorId, status])
  @@index([status, startsAt, endsAt])
}

// The files behind one piece of content — same shape as PointPhoto, for the
// same reason: the bytes are on disk, the row says what they are.
model MarketingAsset {
  id          String           @id @default(cuid())
  contentId   String
  content     MarketingContent @relation(fields: [contentId], references: [id], onDelete: Cascade)
  storageKey  String           @unique
  contentType String
  sizeBytes   Int
  // Milliseconds, for a video. §41 caps it at sixty seconds.
  durationMs  Int?
  position    Int              @default(0)
  uploadedAt  DateTime         @default(now())

  @@index([contentId, position])
}

// §44 "Показы и клики по контенту, просмотры видео", US-44. Written from the
// browser (see POST /v1/marketing/events): only it knows the block actually
// reached a person — a page rendered for a crawler or a prefetch is not a
// show. One row per event, so any window can be counted later.
model ContentEvent {
  id        String           @id @default(cuid())
  contentId String
  content   MarketingContent @relation(fields: [contentId], references: [id], onDelete: Cascade)
  kind      ContentEventKind
  // Who saw it, when they were signed in. Null for a visitor: §44's returning
  // share can only count the ones we can recognise.
  userId    String?
  user      User?            @relation("ContentViewer", fields: [userId], references: [id], onDelete: SetNull)
  // The point card it was shown on, when it was shown on one.
  pointId   String?
  at        DateTime         @default(now())

  @@index([contentId, kind, at])
  @@index([at])
}

enum ContentEventKind {
  IMPRESSION
  CLICK
  VIDEO_VIEW
}

enum MarketingContentType {
  BANNER
  VIDEO
  GALLERY
  PROMO
  NEWS
  LINK
}

// §41 "Таргетинг". CARD_HOLDERS never matches anybody: Poolwatt white label
// cards do not exist yet (§19 waits for the EMI), and an offer aimed at
// holders of a card nobody can have is an advertisement that misleads — the
// one thing §41 forbids outright.
enum MarketingAudience {
  ALL
  NEWCOMERS
  REGULARS
  COOP_MEMBERS
  CARD_HOLDERS
}

enum MarketingStatus {
  DRAFT
  REVIEW
  APPROVED
  REJECTED
}

// ---------------------------------------------------------------------------
// §42 "Конструктор подарков" / §43 "Подарочные кВт·ч" / US-41, US-42, US-43.
//
// A gift is not tokens in the driver's wallet. It is a right to take N kWh in
// one partner's network, and §43's three prohibitions ("нельзя перевести
// другому пользователю, продать на бирже или вывести в деньги") hold by
// construction: a grant is not in `Wallet.kwhBalance` and no batch stands
// behind it.
//
// The energy still comes from somewhere, and it comes from the partner: when a
// grant is spent, batches are burned out of the wallet that funds the campaign
// — the partner gives away their own generation and the driver pays nothing.
// ---------------------------------------------------------------------------

model Campaign {
  id         String          @id @default(cuid())
  operatorId String
  operator   ChargerOperator @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  name       String

  // §42 "Триггер".
  trigger           CampaignTrigger
  // The N of "N-ная зарядка", or the kWh of "объём зарядки за период".
  triggerN          Int?
  triggerPeriodDays Int?

  // §42 "Подарок". Three kinds, combinable: a fixed number of kWh, a
  // percentage discount on the next charge, a free booking. The discount is
  // energy too — `giftKwh` is then the ceiling the partner reserves for it,
  // because the real size is only known when the session happens.
  giftKwh     Decimal  @db.Decimal(18, 3)
  // §42 "скидка в % на следующую зарядку". The share of a session the partner
  // covers out of its own generation; the driver pays for the rest.
  discountPct Decimal? @db.Decimal(5, 2)
  // §42 "бесплатная бронь" — a right to one booking with no fee (§33).
  freeBooking Boolean  @default(false)
  // §8, US-12 — the share of a token-paid session that comes back, for a
  // campaign whose trigger is TOKEN_PAYMENT. Null for a gift campaign.
  cashbackPct Decimal? @db.Decimal(5, 2)

  // §42 "Где действует" — empty means the whole network.
  scopePointIds String[] @default([])

  // §42 "Срок действия" and "Ограничения".
  validityDays     Int
  oncePerClient    Boolean  @default(true)
  minNextChargeKwh Decimal? @db.Decimal(18, 3)
  // §42 "не суммируется с другими акциями" — a session this gift is used in
  // uses no other gift, so the driver gets the single best one.
  exclusive        Boolean  @default(false)

  // §42 "регистрация по QR-коду или промокоду партнёра". Stored upper-case,
  // and unique across every network: the driver types a code without saying
  // whose it is, so two campaigns answering to one code would be a coin toss.
  // The QR sticker is a link carrying the same code.
  promoCode String? @unique

  // §42 "Бюджет кампании" — in kWh. A budget in money needs the partner's
  // settlement account, which the EMI has not issued (see `gates.ts`).
  budgetKwh    Decimal @db.Decimal(18, 3)
  // Issued and not yet expired. Burning a grant's unused remainder gives it
  // back, which is §43's "сгоревший объём возвращается в бюджет кампании".
  issuedKwh    Decimal @default(0) @db.Decimal(18, 3)
  // A free booking costs no kWh, and a budget in money waits for the EMI, so
  // the only honest ceiling for it is a count of gifts. Null means no count
  // limit; the kWh budget still stops the energy ones.
  budgetGrants Int?
  issuedGrants Int     @default(0)

  // §42 "Источник финансирования". TOKENS burns the partner's own batches;
  // FIAT waits for the EMI.
  fundingSource CampaignFunding @default(TOKENS)
  // The wallet the energy comes out of: the claiming user's, in this zone.
  zoneId        String
  zone          GridZone        @relation(fields: [zoneId], references: [id])

  status      CampaignStatus @default(DRAFT)
  pauseReason String?
  startsAt    DateTime?
  endsAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  grants PromoGrant[]

  @@index([operatorId, status])
  @@index([status, startsAt, endsAt])
}

model PromoGrant {
  id         String          @id @default(cuid())
  campaignId String
  campaign   Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId     String
  user       User            @relation("PromoGrantHolder", fields: [userId], references: [id], onDelete: Cascade)
  // §43 "привязан к сети партнёра (network_id)". Denormalised from the
  // campaign on purpose: every spend checks it, on the hot path of a charge.
  operatorId String
  operator   ChargerOperator @relation(fields: [operatorId], references: [id], onDelete: Cascade)

  // US-12 — the charge that earned this, when one did. A gift of §42 is
  // earned by a charge too, so it is filled in for both.
  paymentId String?
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  // §42's "комбинация" — one campaign can hand out one of each kind, so the
  // kind is part of what makes a grant unique.
  kind PromoGrantKind @default(ENERGY)

  // For an ENERGY grant: the kWh promised, and for a discount the ceiling the
  // partner reserved. A FREE_BOOKING grant carries 0.
  amountKwh   Decimal  @db.Decimal(18, 3)
  usedKwh     Decimal  @default(0) @db.Decimal(18, 3)
  // Copied from the campaign when the grant is issued: a later edit of the
  // campaign must not change a gift someone already holds.
  discountPct Decimal? @db.Decimal(5, 2)
  // FREE_BOOKING — a gift for one booking, so one use.
  usedCount   Int      @default(0)

  expiresAt DateTime
  status    PromoGrantStatus @default(ACTIVE)

  issuedAt   DateTime  @default(now())
  lastUsedAt DateTime?
  // US-41 "push клиенту" — when the client was actually told. Null means the
  // worker sweep still owes them a letter.
  notifiedAt DateTime?

  // §42 "Один раз на клиента", as a rule of the database rather than a check
  // that two simultaneous charges can both pass. "once" for a campaign that
  // gives once, null for one that repeats (US-12's cashback) — Postgres
  // treats nulls in a unique index as distinct, so the repeat is allowed and
  // the once-per-client rule still cannot be broken by a race.
  onceKey String?

  @@unique([campaignId, userId, onceKey])
  // US-12 — one accrual per campaign per charge, whatever retries happen. The
  // kind is in the key because §42's combination gives two gifts for one
  // charge: energy and a free booking.
  @@unique([campaignId, paymentId, kind])
  @@index([userId, status, expiresAt])
  @@index([status, expiresAt])
}

enum CampaignTrigger {
  FIRST_CHARGE
  NTH_CHARGE
  VOLUME_PERIOD
  // §42 — the driver arrives with the partner's code or QR sticker, and the
  // gift is issued there and then, without a charge.
  PROMO_CODE
  // §42 "день рождения клиента" — the daily worker pass issues it.
  BIRTHDAY
  // §8, US-12 — every session paid with tokens, not an n-th one.
  TOKEN_PAYMENT
  // §51 "партнёр может настроить компенсацию подарочными кВт·ч своей сети за
  // неудобство". Nothing earns it: support hands it out on a ticket, which is
  // why `triggerFired` answers "no" for it like it does for a promo code.
  COMPENSATION
}

enum PromoGrantKind {
  ENERGY
  FREE_BOOKING
}

enum CampaignFunding {
  TOKENS
  FIAT
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  EXHAUSTED
  ENDED
}

enum PromoGrantStatus {
  ACTIVE
  USED
  EXPIRED
  REVOKED
}

// ---------------------------------------------------------------------------
// §54 — "Любое изменение тарифа версионируется: новые сделки идут по новой
// версии, текущие брони и заявки — по старой."
//
// An append-only journal of every tariff a partner has ever set. `params` is a
// snapshot, not a reference: a point can be deleted and its `PointTariff` rows
// with it, and a receipt issued last March must still print the price it was
// issued at.
//
// Written only by `src/lib/pricing/pricing-service.ts`, in the same
// transaction as the live table it mirrors — a version without a change and a
// change without a version are equally useless.
// ---------------------------------------------------------------------------

model PricingRule {
  id      String       @id @default(cuid())
  scope   PricingScope
  // The thing the rule is about: a point, a network, an asset.
  scopeId String

  // Who it belongs to, for the partner's own history page. One of the two.
  operatorId String?
  operator   ChargerOperator? @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  companyId  String?
  company    Company?         @relation(fields: [companyId], references: [id], onDelete: Cascade)

  version     Int
  params      Json
  activeFrom  DateTime @default(now())
  createdById String?
  note        String?

  createdAt DateTime @default(now())

  // The version counter is a rule of the database: two partners saving at the
  // same moment must not both become version 4.
  @@unique([scope, scopeId, version])
  @@index([scope, scopeId, activeFrom])
  @@index([operatorId, activeFrom])
  @@index([companyId, activeFrom])
}

enum PricingScope {
  // §52 "Цены кВт·ч в деньгах и токенах, по времени суток" + "Плата за
  // простой" + "Скидки для членов кооператива" — all of `PointTariff`.
  POINT_TARIFF
  // §52 one price across the whole network.
  NETWORK_PRICE
  // §33 / §52 "Плата за бронь, гарантия, штраф".
  RESERVATION_POLICY
  // §30 / §52 "Минимальная цена продажи и доли выработки".
  SALE_RULES
  // §52 "Комиссия для своих субпартнёров".
  SUBPARTNER_FEE
}

// ---------------------------------------------------------------------------
// §53 "Что настраивает оператор Poolwatt" — platform commission by partner
// type and plan, partner plans with a subscription, and individual terms for
// a particular partner.
//
// `FeePlan` above stays what it is: two percentages that `fees.ts` already
// reads on the hot path of every fill. This is the layer §53 asks for on top
// of it — a tier, a subscription, a booking commission, and overrides.
// ---------------------------------------------------------------------------

model PlatformFeePlan {
  id              String       @id @default(cuid())
  name            String       @unique
  tier            PlanTier     @default(BASIC)
  // §53 "по типу партнёра". Null means the plan fits any type.
  participantType CompanyType?

  // §53 "Комиссия платформы со сделки, зарядки, брони".
  tradeFeePct   Decimal @default(1) @db.Decimal(5, 2)
  chargeFeePct  Decimal @default(2) @db.Decimal(5, 2)
  bookingFeePct Decimal @default(0) @db.Decimal(5, 2)

  // §53 "подписка на облачную бухгалтерию, CRM, маркетинг сверх бесплатного
  // объёма". The amount is the owner's commercial decision; zero means the
  // tier is free, which is the honest default until they name a number.
  subscriptionFiat   Decimal @default(0) @db.Decimal(10, 2)
  subscriptionPeriod String  @default("month")
  currency           String  @default("EUR")

  // What the subscription includes before anything is charged on top.
  includedInvoices  Int?
  includedCampaigns Int?

  isDefault Boolean  @default(false)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  partners PartnerPlan[]

  @@index([participantType, active])
}

// Who is on which plan, and §53's "Индивидуальные условия для отдельных
// партнёров": `overrides` holds only the fields that differ, so a change to
// the plan still reaches a partner who overrode something else.
model PartnerPlan {
  id String @id @default(cuid())

  companyId  String?
  company    Company?         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  operatorId String?
  operator   ChargerOperator? @relation(fields: [operatorId], references: [id], onDelete: Cascade)

  planId String
  plan   PlatformFeePlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  overrides  Json     @default("{}")
  activeFrom DateTime @default(now())
  note       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId])
  @@unique([operatorId])
  @@index([planId])
}

enum PlanTier {
  BASIC
  EXTENDED
  CORPORATE
}

// §52 last row — "Комиссия для своих субпартнёров (если партнёр — сеть с
// франчайзи)". The head network keeps a percentage of what is charged at a
// franchisee's points, on top of the platform's own commission (§53).
//
// Both sides read the same row, so §54's "расчёт комиссий … с отражением в
// облачной бухгалтерии обеих сторон" is one number, not two.
model SubpartnerAgreement {
  id String @id @default(cuid())

  headId String
  head   ChargerOperator @relation("SubpartnerHead", fields: [headId], references: [id], onDelete: Cascade)
  // The franchisee whose points the commission is taken at.
  subId  String
  sub    ChargerOperator @relation("SubpartnerSub", fields: [subId], references: [id], onDelete: Cascade)

  // Taken from what the franchisee earns on a session, after the platform's
  // own commission: the platform is paid first, as §53 has it.
  chargeFeePct Decimal @db.Decimal(5, 2)

  active     Boolean  @default(true)
  activeFrom DateTime @default(now())
  note       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([headId, subId])
  @@index([subId, active])
}

// §29.6 / US-25 — "Шаблоны: владелец сети пунктов создаёт шаблон и применяет
// его ко всем своим пунктам массово."
//
// A template holds what §29.5 lets an owner change without going back through
// moderation: the tariffs and the opening hours. Address and equipment are
// deliberately not here — changing those needs the operator to look again, and
// a template that quietly un-published fifty points would be a trap.
model PointTemplate {
  id         String          @id @default(cuid())
  operatorId String
  operator   ChargerOperator @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  name       String

  // §28 "Тарифы" — the same shape `PointTariff` stores, as a snapshot.
  tariffs Json @default("[]")

  // §28 "Режим работы".
  open24      Boolean @default(false)
  openHours   Json?
  holidayNote String?

  // §28 "Способы оплаты" and "Удобства": an owner rolling out a tariff
  // usually means the whole commercial offer.
  paymentMethods String[] @default([])
  amenities      String[] @default([])

  lastAppliedAt    DateTime?
  lastAppliedCount Int       @default(0)

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([operatorId, name])
  @@index([operatorId, updatedAt])
}

// ---------------------------------------------------------------------------
// §48 "Воронка развития сети" / US-51 — "Канбан по этапам с ответственными и
// сроками."
//
// A lead is a place that might become a point. The seven stages are §48's own
// words, in §48's order, and a lead that reaches PUBLISHED carries the id of
// the point it became — so the funnel can be read against reality rather than
// against somebody's optimism.
// ---------------------------------------------------------------------------

model SiteLead {
  id         String          @id @default(cuid())
  operatorId String
  operator   ChargerOperator @relation(fields: [operatorId], references: [id], onDelete: Cascade)

  title       String
  country     String?
  city        String?
  addressLine String?
  latitude    Float?
  longitude   Float?

  stage           LeadStage @default(SCOUTING)
  // §48 "На каждом этапе ответственный, срок". The person answerable is an
  // employee of the network (§47), so the scope rules already apply to them.
  ownerEmployeeId String?
  ownerEmployee   Employee? @relation(fields: [ownerEmployeeId], references: [id], onDelete: SetNull)
  dueAt           DateTime?

  // Where the lead sits inside its column, so a board can be reordered.
  position Int @default(0)

  // The point it became, once it did. Null for everything still in flight.
  pointId String?          @unique
  point   AcceptancePoint? @relation(fields: [pointId], references: [id], onDelete: SetNull)

  // Dropped leads stay on the board's history: a funnel without its losses
  // measures nothing.
  lostAt     DateTime?
  lostReason String?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  notes     LeadNote[]
  documents LeadDocument[]

  @@index([operatorId, stage, position])
  @@index([operatorId, dueAt])
}

// §48 "комментарии".
model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  lead      SiteLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorId  String?
  text      String   @db.Text
  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
}

// §48 "документы". The bytes live outside the web root, like the KYB papers
// of §4: a lease or a grid agreement is not a public file.
model LeadDocument {
  id           String   @id @default(cuid())
  leadId       String
  lead         SiteLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  name         String
  storageKey   String   @unique
  contentType  String
  sizeBytes    Int
  uploadedById String?
  uploadedAt   DateTime @default(now())

  @@index([leadId, uploadedAt])
}

// §48 — "поиск места → переговоры → договор → проект и согласования с сетью →
// монтаж → подключение и тест → публикация".
enum LeadStage {
  SCOUTING
  NEGOTIATION
  CONTRACT
  DESIGN
  INSTALLATION
  COMMISSIONING
  PUBLISHED
}

// ---------------------------------------------------------------------------
// §49 "Склад запчастей" / US-50 — "Как кладовщик, хочу получать заявку при
// падении остатка ниже минимума: автоматическая заявка и уведомление."
//
// Four tables, because §49 asks for four things: what a part is, where stock
// sits, how much sits there, and every movement between them. The stock level
// is never written by hand — it is the sum of the movements, and the daily
// reconciliation of §16.11 checks that it is.
// ---------------------------------------------------------------------------

model SparePart {
  id         String          @id @default(cuid())
  operatorId String
  operator   ChargerOperator @relation(fields: [operatorId], references: [id], onDelete: Cascade)

  // §49 "артикул, производитель, совместимые модели оборудования".
  sku              String
  name             String
  manufacturer     String?
  compatibleModels String[] @default([])
  // §49 "Стоимость запчастей автоматически попадает … в себестоимость".
  unitCostFiat     Decimal? @db.Decimal(12, 2)
  currency         String   @default("EUR")
  // §49 "Учёт гарантии: серийный номер" — whether this part is tracked by one.
  serialTracked    Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stock     StockItem[]
  movements StockMovement[]

  @@unique([operatorId, sku])
  @@index([operatorId, name])
}

// §49 "Склады: центральный склад, региональные склады, машина бригады".
model Warehouse {
  id         String          @id @default(cuid())
  operatorId String
  operator   ChargerOperator @relation(fields: [operatorId], references: [id], onDelete: Cascade)

  name             String
  kind             WarehouseKind @default(REGIONAL)
  city             String?
  // A van belongs to the engineer who drives it.
  keeperEmployeeId String?
  keeperEmployee   Employee?     @relation("WarehouseKeeper", fields: [keeperEmployeeId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stock        StockItem[]
  movementsOut StockMovement[]  @relation("MovementFrom")
  movementsIn  StockMovement[]  @relation("MovementTo")
  requests     RestockRequest[]

  @@unique([operatorId, name])
  @@index([operatorId, kind])
}

// §49 "Остатки в реальном времени; минимальный остаток".
model StockItem {
  id          String    @id @default(cuid())
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  partId      String
  part        SparePart @relation(fields: [partId], references: [id], onDelete: Cascade)

  // Never written by hand: the sum of this item's movements.
  qty    Int @default(0)
  minQty Int @default(0)

  updatedAt DateTime @updatedAt

  @@unique([warehouseId, partId])
  @@index([partId])
}

// §49 "Операции: приход, перемещение, выдача на наряд, списание, возврат
// неисправной детали, инвентаризация." Append-only: a movement is what
// happened, and a stock level that disagrees with the sum of them is a bug.
model StockMovement {
  id     String            @id @default(cuid())
  partId String
  part   SparePart         @relation(fields: [partId], references: [id], onDelete: Cascade)
  kind   StockMovementKind

  fromWarehouseId String?
  fromWarehouse   Warehouse? @relation("MovementFrom", fields: [fromWarehouseId], references: [id], onDelete: SetNull)
  toWarehouseId   String?
  toWarehouse     Warehouse? @relation("MovementTo", fields: [toWarehouseId], references: [id], onDelete: SetNull)

  qty Int

  // §49 — a part issued to a work order, and the serial it was installed under.
  workOrderId String?
  workOrder   WorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  serialNo    String?

  unitCostFiat Decimal? @db.Decimal(12, 2)
  note         String?
  actorId      String?
  at           DateTime @default(now())

  @@index([partId, at])
  @@index([fromWarehouseId, at])
  @@index([toWarehouseId, at])
  @@index([workOrderId])
}

// US-50 — the request raised the moment a level crosses its minimum, and the
// letter that tells the keeper about it.
model RestockRequest {
  id          String    @id @default(cuid())
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  partId      String

  // What it looked like when the request was raised, kept verbatim: a level
  // that moves afterwards must not rewrite why somebody was asked to order.
  qtyAtRequest Int
  minQty       Int
  suggestedQty Int

  status     RestockStatus @default(OPEN)
  notifiedAt DateTime?
  closedAt   DateTime?
  closedById String?
  note       String?

  createdAt DateTime @default(now())

  // One open request per part per warehouse: a level sitting below its
  // minimum for a week is one problem, not seven.
  @@unique([warehouseId, partId, status])
  @@index([status, createdAt])
}

enum WarehouseKind {
  CENTRAL
  REGIONAL
  VAN
}

enum StockMovementKind {
  // §49's six operations.
  RECEIPT
  TRANSFER
  ISSUE
  WRITE_OFF
  RETURN_FAULTY
  STOCKTAKE
}

enum RestockStatus {
  OPEN
  ORDERED
  CLOSED
}
