generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id                String    @id @default(cuid())
  // Nickname + bcrypt password registration, or Taler ID (no password, nickname
  // derived from the name). Email is optional: password recovery needs it.
  username          String    @unique // 3–30 chars, lowercase, [a-z0-9_-]
  passwordHash      String? // bcryptjs hash; null = signs in with Taler ID only
  email             String?   @unique
  name              String?
  image             String?
  phone             String? // E.164, optional
  role              Role      @default(USER)
  preferredLocale   String    @default("en")
  preferredCurrency String    @default("USD")
  preferredTheme    String    @default("system")
  // §46 "Клиент выбирает способ в настройках; по умолчанию только
  // электронный" — both on, paper happens on demand at the terminal.
  receiptEmail      Boolean   @default(true)
  receiptPush       Boolean   @default(true)
  emailVerified     DateTime?
  // §42's birthday trigger. Day and month only, given voluntarily: a year
  // would be one more piece of personal data for no extra use.
  birthDay          Int?
  birthMonth        Int?
  createdAt         DateTime  @default(now())

  accounts                Account[]
  sessions                Session[]
  ownedProducers          Producer[]               @relation("ProducerOwner")
  watchlist               Watchlist[]
  hubWatchlist            HubWatchlist[]
  chargerFavorites        ChargerFavorite[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  producerRequests        ProducerRequest[]
  reviewedRequests        ProducerRequest[]        @relation("RequestReviewer")
  // §46 — a receipt claim filed, a claim answered, a correction issued.
  receiptClaims           ReceiptClaim[]           @relation("ReceiptClaimant")
  receiptClaimsResolved   ReceiptClaim[]           @relation("ReceiptClaimResolver")
  receiptCorrections      ReceiptCorrection[]      @relation("ReceiptCorrector")
  adminAddedProducers     Producer[]               @relation("AdminProducerAdditions")
  claimedProducers        Producer[]               @relation("ProducerClaims")
  claimedChargerOperators ChargerOperator[]        @relation("ChargerOperatorClaims")
  auditLogs               AdminAuditLog[]          @relation("AdminAuditActor")
  buyContracts            Contract[]               @relation("ContractBuyer")
  buildRequests           BuildRequest[]           @relation("BuildRequestOwner")
  reviewedBuildRequests   BuildRequest[]           @relation("BuildRequestReviewer")
  contractorMemberships   ContractorMember[]       @relation("ContractorMembership")
  reviewedContractors     Contractor[]             @relation("ContractorReviewer")
  claimTokens             ClaimToken[]
  staffMemberships        Employee[]               @relation("StaffMembership")
  reservations            Reservation[]            @relation("ReservationDriver")
  reportedTickets         Ticket[]                 @relation("TicketReporter")
  ticketMessages          TicketMessage[]          @relation("TicketMessageAuthor")
  refundsDecided          PaymentRefund[]          @relation("RefundDecidedBy")

  // Exchange core (ТЗ §4–§8).
  ownedCompanies     Company[]            @relation("CompanyOwner")
  reviewedListings   ListingApplication[] @relation("ListingReviewer")
  screeningChecks    ScreeningCheck[]     @relation("ScreeningChecker")
  wallets            Wallet[]
  settlementAccount  SettlementAccount?   @relation("UserSettlementAccount")
  coopMemberships    CoopMember[]         @relation("CoopMembership")
  promoGrants        PromoGrant[]         @relation("PromoGrantHolder")
  roamingSessions    RoamingSettlement[]  @relation("RoamingDriver")
  dashboards         Dashboard[]          @relation("DashboardOwner")
  contentViews       ContentEvent[]       @relation("ContentViewer")
  chargeSessions     ChargeSession[]      @relation("ChargeSessionDriver")
  pointReviews       PointReview[]
  deviceKeys         DeviceKey[]
  webauthnChallenges WebAuthnChallenge[]
}

// V1: user picked an email and we sent them a verification link. Token is
// 32 random bytes (hex). On consume, user.email + user.emailVerified are set.
model EmailVerificationToken {
  token     String   @id
  userId    String
  email     String // candidate email being verified
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// V1: user clicked "Forgot password" with a verified email on file.
model PasswordResetToken {
  token     String    @id
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// V1: favorites of EV charging stations. chargerId stores the mock station id
// (e.g. "ch_tesla_supercharger_bratislava") since chargers aren't in the DB
// yet — they live in src/lib/chargers-mock.ts. A later DB cutover spec will
// either repoint this to a real FK or migrate the column.
model ChargerFavorite {
  userId    String
  chargerId String
  addedAt   DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, chargerId])
  @@index([userId, addedAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Renewable source category for the household's power-bank charging mix.
enum RenewableSource {
  SOLAR
  WIND
  HYDRO
  BIOMASS
  GEOTHERMAL
  HYBRID
}

enum ProducerSource {
  AUTO_FEED // imported from a partner aggregator feed
  ADMIN_ADDED // manually whitelisted by admin
  SELF_ENROLLED // household signed up through the portal
}

enum ProducerCategory {
  ENERGY_PRODUCER
  EQUIPMENT_MANUFACTURER
}

enum ClaimEntityType {
  PRODUCER
  CHARGER_OPERATOR
}

// One-time email-verification token used by the producer claim flow.
// Created when a user submits the claim form with a corporate email; consumed
// on successful verification. expiresAt is 30 minutes from creation by
// convention (enforced by the application layer, not by the DB).
model ClaimToken {
  id         String          @id @default(cuid())
  token      String          @unique
  entityType ClaimEntityType
  entityId   String
  email      String
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime        @default(now())

  @@index([entityType, entityId])
  @@index([userId])
}

// EV-charging-network operator (IONITY, GreenWay, Tesla, ChargePoint, …).
// Aliases hold the variations of operator/network/brand tags from OSM data
// so a single ChargerOperator row matches all stations of that network.
model ChargerOperator {
  id          String   @id @default(cuid())
  slug        String   @unique
  displayName String
  aliases     String[] @default([])
  description String?  @db.Text
  websiteUrl  String?
  logoUrl     String?
  email       String?
  phone       String?

  // Operator-level default tariff. Travelers see this on every station whose
  // OCM `operator` string matches one of `aliases`. Step 4 will add an API
  // for operators to update this in real time; for now it's set via cabinet.
  pricePerKwh    Decimal?  @db.Decimal(8, 4)
  priceCurrency  String?   @db.VarChar(8)
  priceUpdatedAt DateTime?

  claimedById String?
  claimedBy   User?     @relation("ChargerOperatorClaims", fields: [claimedById], references: [id])
  claimedAt   DateTime?

  apiKeys     ChargerOperatorApiKey[]
  accounting  OperatorAccounting?
  points      AcceptancePoint[]
  roles       StaffRole[]
  employees   Employee[]
  crews       Crew[]
  workOrders  WorkOrder[]
  tickets     Ticket[]
  marketing   MarketingContent[]
  campaigns   Campaign[]
  promoGrants PromoGrant[]

  pricingRules      PricingRule[]
  partnerPlan       PartnerPlan?
  // §52 — a network can be the head of franchisees, or a franchisee itself.
  subpartnersAsHead SubpartnerAgreement[] @relation("SubpartnerHead")
  subpartnerOf      SubpartnerAgreement[] @relation("SubpartnerSub")
  pointTemplates    PointTemplate[]
  siteLeads         SiteLead[]
  spareParts        SparePart[]
  // §46 — the claims this network's accountant returned to support.
  receiptClaims     ReceiptClaim[]
  warehouses        Warehouse[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([claimedById])
}

// ---------------------------------------------------------------------------
// §28 "Карточка пункта" / §29 lifecycle / §31 (AcceptancePoint, Connector,
// Tariff). A point of acceptance is somebody's: it has an owner, tariffs, a
// connection and live occupancy. OpenStreetMap stations stay what they are —
// other people's pins on the map, with none of that.
// ---------------------------------------------------------------------------

model AcceptancePoint {
  id         String          @id @default(cuid())
  operatorId String
  operator   ChargerOperator @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  type       PointType
  name       String
  status     PointStatus     @default(DRAFT)

  // §28 "Адрес и карта"
  country     String? // ISO-3166 alpha-2
  city        String?
  addressLine String?
  latitude    Float?
  longitude   Float?
  gridZoneId  String?
  gridZone    GridZone? @relation(fields: [gridZoneId], references: [id])
  howToFind   String?   @db.Text

  // §28 "Источник энергии"
  energySource     PointEnergySource?
  goCertificateRef String?

  // §28 "Оборудование" — connectors are rows; this is what belongs to the point.
  storageKwh Decimal? @db.Decimal(12, 3)

  // §28 "Режим работы". `openHours` is a per-weekday schedule kept as JSON:
  // seven rows of {from,to} or null for a closed day.
  open24      Boolean   @default(false)
  openHours   Json?
  holidayNote String?
  closedFrom  DateTime?
  closedUntil DateTime?

  // §28 "Способы оплаты" and "Удобства" — small closed vocabularies, kept as
  // string arrays rather than join tables: nothing ever queries one alone.
  paymentMethods String[]
  amenities      String[]

  // §28 "Подключение"
  ocppVersion String? // "1.6" | "2.0.1"
  meterId     String?

  // §28 "Видимость" and "Бренд"
  visibility  PointVisibility @default(PUBLIC)
  logoUrl     String?
  pinColor    String?
  description String?         @db.Text

  // §29 moderation trail, the same shape the listing review uses.
  submittedAt  DateTime?
  reviewedAt   DateTime?
  reviewedById String?
  reviewNote   String?
  publishedAt  DateTime?
  // When the equipment last told us how busy it is (§29.7).
  lastSeenAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  connectors     PointConnector[]
  tariffs        PointTariff[]
  photos         PointPhoto[]
  apiKeys        PointApiKey[]
  workOrders     WorkOrder[]
  tickets        Ticket[]
  reservations   Reservation[]
  payments       Payment[]
  policy         ReservationPolicy?
  SiteLead       SiteLead?
  chargeSessions ChargeSession[]
  reviews        PointReview[]

  @@index([operatorId, status])
  @@index([status, latitude, longitude])
}

model PointConnector {
  id        String          @id @default(cuid())
  pointId   String
  point     AcceptancePoint @relation(fields: [pointId], references: [id], onDelete: Cascade)
  type      EvConnectorType
  powerKw   Decimal         @db.Decimal(8, 2)
  currentAc Boolean         @default(true)
  quantity  Int             @default(1)
  // §27 "свободен, занят, не работает" — UNKNOWN until the equipment reports.
  status    ConnectorStatus @default(UNKNOWN)
  statusAt  DateTime?

  tickets        Ticket[]
  reservations   Reservation[]
  payments       Payment[]
  chargeSessions ChargeSession[]
  statusLog      ConnectorStatusLog[]

  @@index([pointId])
  @@index([type, status])
}

// §27 «история доступности», §29.7 «статус обновляется автоматически».
// Занятость разъёма меняют пять мест — телеметрия оборудования, бронь, её
// снятие, старт и конец сеанса, наряд по поломке. Все они идут через
// `setConnectorStatus`, и запись появляется только когда состояние
// действительно изменилось: иначе оборудование, которое отчитывается раз в
// минуту, за сутки нарисует тысячу четыреста строк «всё так же свободно».
model ConnectorStatusLog {
  id          String          @id @default(cuid())
  connectorId String
  connector   PointConnector  @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  // Денормализовано: карточка читает журнал по пункту, а не по разъёму.
  pointId     String
  status      ConnectorStatus
  at          DateTime        @default(now())
  // equipment | booking | booking-release | session-start | session-end | ticket
  source      String

  @@index([pointId, at])
  @@index([connectorId, at])
}

// §28 "Тарифы". One row per time-of-day window; a point with a flat price has
// one row covering the whole day.
model PointTariff {
  id            String          @id @default(cuid())
  pointId       String
  point         AcceptancePoint @relation(fields: [pointId], references: [id], onDelete: Cascade)
  label         String?
  fromMinute    Int             @default(0) // minutes from midnight, inclusive
  toMinute      Int             @default(1440) // exclusive
  priceFiat     Decimal?        @db.Decimal(10, 4)
  currency      String          @default("EUR")
  priceTokens   Decimal?        @db.Decimal(10, 4) // kWh tokens per kWh
  idleFeePerMin Decimal?        @db.Decimal(10, 4)
  coopDiscount  Int             @default(0) // percent off for cooperative members

  @@index([pointId])
}

// §28 — up to ten photos, stored outside /public like the listing documents.
model PointPhoto {
  id          String          @id @default(cuid())
  pointId     String
  point       AcceptancePoint @relation(fields: [pointId], references: [id], onDelete: Cascade)
  storageKey  String          @unique
  contentType String
  sizeBytes   Int
  position    Int             @default(0)
  uploadedAt  DateTime        @default(now())

  @@index([pointId, position])
}

// §27 «Полная карточка: … отзывы». Отзыв оставляет тот, кто здесь заряжался
// или чья бронь была исполнена: отзыв, не привязанный ни к одному приезду, —
// это способ испортить чужую карточку, а приезд у нас уже записан в базе.
// Один отзыв на человека и пункт, свой можно переписать.
model PointReview {
  id        String          @id @default(cuid())
  pointId   String
  point     AcceptancePoint @relation(fields: [pointId], references: [id], onDelete: Cascade)
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  text      String?         @db.Text
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([pointId, userId])
  @@index([pointId, createdAt])
}

// The equipment credential of one point — the same shape as AssetApiKey:
// plaintext shown once, only a hash stored, HMAC secret sealed (§15).
model PointApiKey {
  id               String          @id @default(cuid())
  pointId          String
  point            AcceptancePoint @relation(fields: [pointId], references: [id], onDelete: Cascade)
  label            String?
  tokenHash        String          @unique
  prefix           String
  signingSecretEnc String?
  signingSecretIv  String?
  createdAt        DateTime        @default(now())
  lastUsedAt       DateTime?
  revokedAt        DateTime?

  @@index([pointId])
}

enum PointType {
  CHARGING_STATION
  POWERBANK
  GENERATION
  MIXED
}

// §29.3 — the same five states an asset goes through, for the same reason.
enum PointStatus {
  DRAFT
  REVIEW
  TEST
  PUBLISHED
  SUSPENDED
}

enum PointEnergySource {
  SOLAR
  WIND
  BIOGAS
  HYDRO
  GRID
  MIXED
}

enum PointVisibility {
  PUBLIC
  COOP_MEMBERS
  OWN_CLIENTS
}

enum ConnectorStatus {
  FREE
  BUSY
  OUT_OF_SERVICE
  // §35 US-30 — "разъём помечен в навигаторе как забронированный".
  BOOKED
  UNKNOWN
}

// ---------------------------------------------------------------------------
// §47 "Сотрудники и роли" / US-47. Permissions are granted over a whole
// network or over named points — "сотрудник видит только разрешённые пункты
// и действия" is the acceptance criterion, so the scope is part of the row.
// ---------------------------------------------------------------------------

model StaffRole {
  id          String          @id @default(cuid())
  operatorId  String
  operator    ChargerOperator @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  name        String
  // Closed vocabulary; see PERMISSIONS in src/lib/staff/staff-service.ts.
  permissions String[]
  // True for the eight roles of §47, which a network gets for free and
  // cannot delete out from under its staff.
  builtIn     Boolean         @default(false)
  createdAt   DateTime        @default(now())

  employees Employee[]

  @@unique([operatorId, name])
}

model Employee {
  id         String          @id @default(cuid())
  operatorId String
  operator   ChargerOperator @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  userId     String
  user       User            @relation("StaffMembership", fields: [userId], references: [id], onDelete: Cascade)
  roleId     String
  role       StaffRole       @relation(fields: [roleId], references: [id])
  // Empty means the whole network; otherwise exactly these points.
  pointIds   String[]
  /// §48 «с учётом региона» — города, которые закрывает этот инженер.
  /// Пусто значит вся сеть, как у `pointIds` выше.
  regions    String[]
  invitedBy  String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  workOrders WorkOrder[]  @relation("WorkOrderAssignee")
  // §48 — the leads this person is answerable for.
  siteLeads  SiteLead[]
  // §49 — the van this engineer drives, if they have one.
  warehouses Warehouse[]  @relation("WarehouseKeeper")
  // §48 — the crews this person rides with.
  crews      CrewMember[]

  @@unique([operatorId, userId])
  @@index([userId])
}

// §48 "Наряды и задачи" / US-48, US-54.
model WorkOrder {
  id             String            @id @default(cuid())
  // An order belongs to whoever answers for the equipment: a charging
  // network for a point, a producer company for a generation asset. Exactly
  // one of the two is set.
  operatorId     String?
  operator       ChargerOperator?  @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  companyId      String?
  company        Company?          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  pointId        String?
  point          AcceptancePoint?  @relation(fields: [pointId], references: [id], onDelete: SetNull)
  assetId        String?
  asset          Asset?            @relation(fields: [assetId], references: [id], onDelete: SetNull)
  type           WorkOrderType
  priority       WorkOrderPriority @default(NORMAL)
  status         WorkOrderStatus   @default(NEW)
  title          String
  description    String            @db.Text
  // §48 — what the engineer should bring. Strings until the warehouse of
  // US-49/US-50 exists.
  partsNeeded    String[]
  photos         String[]
  assigneeId     String?
  assignee       Employee?         @relation("WorkOrderAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  /// §48 «назначение инженеру **или** бригаде»: заполнено ровно одно из двух.
  crewId         String?
  crew           Crew?             @relation(fields: [crewId], references: [id], onDelete: SetNull)
  // What produced it, so the same fault never makes two orders.
  sourceAlertId  String?           @unique
  sourceAlert    AssetAlert?       @relation("AlertWorkOrder", fields: [sourceAlertId], references: [id], onDelete: SetNull)
  sourceTicketId String?           @unique
  notifiedAt     DateTime?
  report         String?           @db.Text
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  closedAt       DateTime?

  ticket        Ticket?             @relation("TicketWorkOrder")
  StockMovement StockMovement[]
  // §48 — то, что инженер делает на объекте.
  tasks         WorkOrderTask[]
  sitePhotos    WorkOrderPhoto[]
  signature     WorkOrderSignature?

  @@index([operatorId, status])
  @@index([companyId, status])
  @@index([assigneeId, status])
  @@index([crewId, status])
}

/// §48 «чек-лист работ». Строка создаётся из типового списка по виду наряда
/// при первом открытии наряда тем, кто имеет право в нём работать: в живой
/// базе наряды уже есть, и чек-лист, появляющийся только у будущих, означал
/// бы, что §48 выполнен для половины.
model WorkOrderTask {
  id          String    @id @default(cuid())
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  position    Int
  title       String
  /// Обязательный пункт нельзя оставить без ответа: закрытие спросит.
  required    Boolean   @default(true)
  doneAt      DateTime?
  doneById    String?
  /// Пропущен с объяснением («щит заперт», «не применимо к этой модели»).
  /// Или отметка, или объяснение — не оба.
  skipReason  String?   @db.Text
  updatedAt   DateTime  @updatedAt

  @@unique([workOrderId, position])
  @@index([workOrderId])
}

enum WorkOrderPhotoStage {
  BEFORE
  AFTER
}

/// §48 «фото до и после». Это снимки **инженера**, а не клиента:
/// `WorkOrder.photos` несёт фотографии заявителя §51, которые лежат в
/// хранилище заявок и принадлежат другому человеку.
model WorkOrderPhoto {
  id          String              @id @default(cuid())
  workOrderId String
  workOrder   WorkOrder           @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  stage       WorkOrderPhotoStage
  key         String              @unique
  takenById   String?
  takenAt     DateTime            @default(now())

  @@index([workOrderId, stage])
}

/// Кто подписал. Инженер, подписавшийся сам, — не подделка подписи клиента:
/// у зарядной станции часто нет никого на месте, и наряд должен говорить об
/// этом прямо.
enum WorkOrderSignerKind {
  SITE_CONTACT
  ENGINEER
}

/// §48 «подпись». Одна на наряд.
model WorkOrderSignature {
  id          String              @id @default(cuid())
  workOrderId String              @unique
  workOrder   WorkOrder           @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  signerKind  WorkOrderSignerKind
  signerName  String
  /// Росчерк с холста, PNG, вне веб-корня.
  key         String              @unique
  signedById  String
  signedAt    DateTime            @default(now())
}

/// §48 «Назначение инженеру или бригаде». Бригада принадлежит сети: §47 —
/// это сеть зарядных пунктов, у компании-производителя сотрудников нет.
model Crew {
  id         String          @id @default(cuid())
  operatorId String
  operator   ChargerOperator @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  name       String
  /// Города бригады; пусто — вся сеть, как у инженера.
  regions    String[]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  members    CrewMember[]
  workOrders WorkOrder[]

  @@unique([operatorId, name])
  @@index([operatorId])
}

/// Инженер может быть в нескольких бригадах: утром монтаж с бригадой, днём
/// жалоба в одиночку.
model CrewMember {
  id         String   @id @default(cuid())
  crewId     String
  crew       Crew     @relation(fields: [crewId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  /// Старший: письмо адресовано ему, остальным — то же письмо.
  lead       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@unique([crewId, employeeId])
  @@index([employeeId])
}

// §51 "Сообщение о поломке от клиента" / US-52, US-54.
model Ticket {
  id                 String            @id @default(cuid())
  operatorId         String
  operator           ChargerOperator   @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  pointId            String?
  point              AcceptancePoint?  @relation(fields: [pointId], references: [id], onDelete: SetNull)
  connectorId        String?
  connector          PointConnector?   @relation(fields: [connectorId], references: [id], onDelete: SetNull)
  // §51 "неверная цена или списание" — which session is being appealed.
  // Filled by a report sent from the charge history; without it a refund has
  // no subject, because support cannot know which debit to give back.
  paymentId          String?
  payment            Payment?          @relation("TicketPayment", fields: [paymentId], references: [id], onDelete: SetNull)
  reporterId         String?
  reporter           User?             @relation("TicketReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  source             String            @default("app")
  problemType        TicketProblemType
  comment            String?           @db.Text
  photos             String[]
  priority           WorkOrderPriority @default(NORMAL)
  status             TicketStatus      @default(OPEN)
  // §48 "SLA по приоритету": when a first response is due.
  respondBy          DateTime?
  workOrderId        String?           @unique
  workOrder          WorkOrder?        @relation("TicketWorkOrder", fields: [workOrderId], references: [id], onDelete: SetNull)
  compensation       String?
  // §51 "клиент видит статус заявки и переписывается с поддержкой в чате".
  messages           TicketMessage[]
  // §51 "Ошибочное списание — возврат после проверки поддержкой".
  refunds            PaymentRefund[]
  // §48 "SLA по приоритету; эскалация". The first answer by a person, not
  // the work order the system opens by itself, is what the SLA measures.
  firstRespondedAt   DateTime?
  escalatedAt        DateTime?
  // §51 "после ремонта клиент получает уведомление, что станция снова
  // работает" — stamped once, so the worker never says it twice.
  recoveryNotifiedAt DateTime?
  resolvedAt         DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  closedAt           DateTime?

  @@index([operatorId, status])
  @@index([reporterId])
  @@index([operatorId, respondBy])
  @@index([paymentId])
}

/// Who said it. Not derived: a network's employee can also be a customer of
/// the same network, so the side someone spoke from is stored, not guessed.
enum TicketAuthorKind {
  CUSTOMER
  SUPPORT
  SYSTEM
}

/// §51 — the conversation on a ticket. Append-only: for both sides this is
/// the evidence of what was said and when.
model TicketMessage {
  id         String           @id @default(cuid())
  ticketId   String
  ticket     Ticket           @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorKind TicketAuthorKind
  authorId   String?
  author     User?            @relation("TicketMessageAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  body       String           @db.Text
  createdAt  DateTime         @default(now())

  @@index([ticketId, createdAt])
}

/// §51 "Ошибочное списание — возврат после проверки поддержкой".
///
/// The money goes back onto the wallet balance it was taken from, which is the
/// same ledger move as the booking fee of US-55 and needs no payment provider.
/// A session paid by card is refused by `receiptRefundsOpen`: money back onto
/// a card is the provider's job, and promising it would be an invention.
model PaymentRefund {
  id          String    @id @default(cuid())
  paymentId   String
  payment     Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  /// The review that decided it. Unique: one review, one refund — a second
  /// refund needs a second review, and that is also what makes two clicks
  /// produce one row without a lock.
  ticketId    String    @unique
  ticket      Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  walletId    String
  wallet      Wallet    @relation(fields: [walletId], references: [id], onDelete: Cascade)
  /// Its own number from `receipt_number_seq`: a partner's accountant refers
  /// to a document, not to a cuid.
  number      String    @unique
  amountFiat  Decimal   @db.Decimal(18, 2)
  currency    String    @default("EUR")
  reason      String    @db.Text
  decidedById String
  decidedBy   User      @relation("RefundDecidedBy", fields: [decidedById], references: [id], onDelete: Cascade)
  /// Null means the worker still owes the driver a letter.
  notifiedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([paymentId])
  @@index([notifiedAt])
  @@index([createdAt])
}

enum WorkOrderType {
  INSTALL
  MAINTENANCE
  REPAIR
  COMPLAINT_CHECK
}

enum WorkOrderPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

// §48 — новый → назначен → в пути → в работе → ожидает запчасть → выполнен →
// проверен.
enum WorkOrderStatus {
  NEW
  ASSIGNED
  EN_ROUTE
  IN_PROGRESS
  WAITING_PART
  DONE
  VERIFIED
  CANCELLED
}

enum TicketProblemType {
  NO_START
  INTERRUPTED
  DAMAGED_CABLE
  SCREEN_DEAD
  BLOCKED
  WRONG_PRICE
  OTHER
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

// §33 "Настройки владельца станции" / US-32. One row per point; a booking
// copies the numbers it was confirmed under, so a change here never moves a
// booking that already exists.
model ReservationPolicy {
  id      String          @id @default(cuid())
  pointId String          @unique
  point   AcceptancePoint @relation(fields: [pointId], references: [id], onDelete: Cascade)

  enabled              Boolean  @default(false)
  // Which connectors may be booked; empty means all of them.
  bookableConnectorIds String[]
  // §33 "Резерв без брони" — always free for whoever just turns up.
  walkUpConnectors     Int      @default(1)
  feeFiat              Decimal  @default(0) @db.Decimal(10, 2)
  feeTokens            Decimal  @default(0) @db.Decimal(10, 3)
  currency             String   @default("EUR")
  // §33 "Зачёт платы" — does the booking fee count towards the charge.
  feeCountsTowards     Boolean  @default(true)
  guaranteeFiat        Decimal  @default(0) @db.Decimal(10, 2)
  noShowPenaltyFiat    Decimal  @default(0) @db.Decimal(10, 2)
  waitMinutes          Int      @default(15)
  freeCancelMinutes    Int      @default(30)
  maxAheadHours        Int      @default(24)
  extendAllowed        Boolean  @default(true)
  extendFeeFiat        Decimal  @default(0) @db.Decimal(10, 2)
  coopFree             Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// §35 Reservation. The policy numbers are copied in, not referenced: US-32
// requires a change to leave existing bookings alone.
model Reservation {
  id          String          @id @default(cuid())
  userId      String
  user        User            @relation("ReservationDriver", fields: [userId], references: [id], onDelete: Cascade)
  pointId     String
  point       AcceptancePoint @relation(fields: [pointId], references: [id], onDelete: Cascade)
  connectorId String
  connector   PointConnector  @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  walletId    String
  wallet      Wallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)

  eta         DateTime
  windowStart DateTime
  windowEnd   DateTime

  // The copy of §33 this booking lives by.
  feeFiat           Decimal @db.Decimal(10, 2)
  guaranteeFiat     Decimal @db.Decimal(10, 2)
  noShowPenaltyFiat Decimal @db.Decimal(10, 2)
  freeCancelMinutes Int
  currency          String  @default("EUR")

  // §54 — which version of §33 the copied numbers above came from.
  pricingVersion Int?

  // §42 "бесплатная бронь" — the gift that paid the fee, when one did.
  promoGrantId String?

  // §32.4 / US-31 — "при опоздании предлагает продлить или перенести бронь".
  // How many times the window has been pushed back, and when the driver was
  // told it was about to close.
  extendCount      Int       @default(0)
  extendRemindedAt DateTime?

  status      ReservationStatus @default(CREATED)
  penaltyFiat Decimal?          @db.Decimal(10, 2)
  refundFiat  Decimal?          @db.Decimal(10, 2)
  closedAt    DateTime?
  closeReason String?
  notifiedAt  DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  receipt       Receipt?
  chargeSession ChargeSession?

  @@index([userId, status])
  @@index([connectorId, status])
  @@index([status, windowEnd])
}

enum ReservationStatus {
  CREATED
  ACTIVE
  FULFILLED
  CANCELLED
  NO_SHOW
  EXPIRED
}

// API tokens that let an operator's external system push tariff updates to
// POST /api/v1/charger-operators/{id}/price. The plaintext token is shown
// to the user exactly once at creation; we only persist a SHA-256 hash.
model ChargerOperatorApiKey {
  id         String          @id @default(cuid())
  operatorId String
  operator   ChargerOperator @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  label      String // user-supplied, e.g. "Production gateway"
  tokenHash  String          @unique // SHA-256 of the plaintext token
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime        @default(now())

  @@index([operatorId])
  @@index([tokenHash])
}

// A household (or small commercial) producer that contributes battery-stored
// renewable electricity to the network.
model Producer {
  id          String  @id @default(cuid())
  slug        String  @unique
  handle      String  @unique // human-friendly id, e.g. "lisbon-rooftop-04"
  displayName String // e.g. "Casa do Sol — Lisbon"
  city        String?
  region      String?
  country     String // ISO 3166-1 alpha-2
  lat         Float?
  lng         Float?

  primarySource RenewableSource
  sourceMix     Json? // e.g. { "SOLAR": 0.7, "WIND": 0.3 }
  capacityKwh   Decimal         @db.Decimal(12, 3) // total powerbank capacity
  inverterKw    Decimal         @db.Decimal(8, 3) // max instantaneous output
  installedAt   DateTime?

  source     ProducerSource @default(SELF_ENROLLED)
  isActive   Boolean        @default(true)
  rank       Int // ranked by lifetime kWh delivered
  logoUrl    String?
  bannerUrl  String?
  bio        String?        @db.Text
  websiteUrl String?
  twitterUrl String?

  ownerId               String?
  owner                 User?            @relation("ProducerOwner", fields: [ownerId], references: [id])
  addedByAdminId        String?
  addedBy               User?            @relation("AdminProducerAdditions", fields: [addedByAdminId], references: [id])
  claimedById           String?
  claimedBy             User?            @relation("ProducerClaims", fields: [claimedById], references: [id])
  claimedAt             DateTime?
  approvedFromRequestId String?          @unique
  approvedFromRequest   ProducerRequest? @relation("ProducerRequestApproved", fields: [approvedFromRequestId], references: [id])

  category     ProducerCategory @default(ENERGY_PRODUCER)
  equipment    String[]         @default([])
  manufactures String[]         @default([])

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  metadataFetchedAt DateTime?

  snapshots      ProducerSnapshot[]
  offers         Offer[]
  contracts      Contract[]
  profile        ProducerProfile?
  producerClaims ProducerBuildRequestClaim[] @relation("ProducerClaimsByProducer")
  // Watchlist FK was dropped in V1 personal cabinet — see comment on the
  // Watchlist model. When the producer cutover lands, restore: watchedBy Watchlist[]

  @@index([claimedById])
  @@index([country, rank])
  @@index([primarySource])
}

// Rich profile data for a Producer: human-readable company info shown on the
// detail page (founded year, CEO, contact, certifications, key products).
// 1:1 with Producer; nullable so seed rows without a matching PRODUCER_PROFILES
// entry stay valid.
model ProducerProfile {
  producerId String   @id
  producer   Producer @relation(fields: [producerId], references: [id], onDelete: Cascade)

  description    String?  @db.Text
  founded        Int?
  employees      String?
  website        String?
  email          String?
  phone          String?
  address        String?
  ceo            String?
  stockTicker    String?
  certifications String[] @default([])
  keyProducts    String[] @default([])

  updatedAt DateTime @updatedAt
}

// Periodic telemetry snapshot per producer: state-of-charge, last 24h delivery, prices.
model ProducerSnapshot {
  id         String   @id @default(cuid())
  producerId String
  producer   Producer @relation(fields: [producerId], references: [id], onDelete: Cascade)

  stateOfChargePct     Float // 0..100
  availableKwh         Decimal  @db.Decimal(12, 3) // currently dischargeable
  delivered24hKwh      Decimal  @db.Decimal(12, 3)
  deliveredLifetimeKwh Decimal  @db.Decimal(16, 3)
  avgPricePerKwhUsd    Decimal  @db.Decimal(10, 6)
  pctChange24h         Float?
  pctChange7d          Float?
  uptimePct            Float?
  carbonOffsetKgCo2e   Decimal? @db.Decimal(14, 3)
  weatherCondition     String? // SUNNY/CLOUDY/WINDY/CALM…
  fetchedAt            DateTime @default(now())

  @@index([producerId, fetchedAt])
}

// Network-wide stats — analog of GlobalStats in the reference project.
model GridStats {
  id                    Int      @id @default(1)
  totalCapacityKwh      Decimal  @db.Decimal(18, 3)
  totalDelivered24hKwh  Decimal  @db.Decimal(18, 3)
  totalLifetimeKwh      Decimal  @db.Decimal(20, 3)
  activeProducers       Int
  activeHubs            Int
  solarSharePct         Float
  windSharePct          Float
  hydroSharePct         Float
  otherSharePct         Float
  carbonOffset24hKgCo2e Decimal  @db.Decimal(16, 3)
