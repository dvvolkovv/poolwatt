generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id                String    @id @default(cuid())
  // Nickname + bcrypt password registration, or Taler ID (no password, nickname
  // derived from the name). Email is optional: password recovery needs it.
  username          String    @unique // 3–30 chars, lowercase, [a-z0-9_-]
  passwordHash      String? // bcryptjs hash; null = signs in with Taler ID only
  email             String?   @unique
  name              String?
  image             String?
  phone             String? // E.164, optional
  role              Role      @default(USER)
  preferredLocale   String    @default("en")
  preferredCurrency String    @default("USD")
  preferredTheme    String    @default("system")
  emailVerified     DateTime?
  createdAt         DateTime  @default(now())

  accounts                Account[]
  sessions                Session[]
  ownedProducers          Producer[]               @relation("ProducerOwner")
  watchlist               Watchlist[]
  hubWatchlist            HubWatchlist[]
  chargerFavorites        ChargerFavorite[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  producerRequests        ProducerRequest[]
  reviewedRequests        ProducerRequest[]        @relation("RequestReviewer")
  adminAddedProducers     Producer[]               @relation("AdminProducerAdditions")
  claimedProducers        Producer[]               @relation("ProducerClaims")
  claimedChargerOperators ChargerOperator[]        @relation("ChargerOperatorClaims")
  auditLogs               AdminAuditLog[]          @relation("AdminAuditActor")
  buyContracts            Contract[]               @relation("ContractBuyer")
  buildRequests           BuildRequest[]           @relation("BuildRequestOwner")
  reviewedBuildRequests   BuildRequest[]           @relation("BuildRequestReviewer")
  contractorMemberships   ContractorMember[]       @relation("ContractorMembership")
  reviewedContractors     Contractor[]             @relation("ContractorReviewer")
  claimTokens             ClaimToken[]

  // Exchange core (ТЗ §4–§8).
  ownedCompanies    Company[]            @relation("CompanyOwner")
  reviewedListings  ListingApplication[] @relation("ListingReviewer")
  screeningChecks   ScreeningCheck[]     @relation("ScreeningChecker")
  wallets           Wallet[]
  settlementAccount SettlementAccount?   @relation("UserSettlementAccount")
  coopMemberships   CoopMember[]         @relation("CoopMembership")
}

// V1: user picked an email and we sent them a verification link. Token is
// 32 random bytes (hex). On consume, user.email + user.emailVerified are set.
model EmailVerificationToken {
  token     String   @id
  userId    String
  email     String // candidate email being verified
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// V1: user clicked "Forgot password" with a verified email on file.
model PasswordResetToken {
  token     String    @id
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// V1: favorites of EV charging stations. chargerId stores the mock station id
// (e.g. "ch_tesla_supercharger_bratislava") since chargers aren't in the DB
// yet — they live in src/lib/chargers-mock.ts. A later DB cutover spec will
// either repoint this to a real FK or migrate the column.
model ChargerFavorite {
  userId    String
  chargerId String
  addedAt   DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, chargerId])
  @@index([userId, addedAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Renewable source category for the household's power-bank charging mix.
enum RenewableSource {
  SOLAR
  WIND
  HYDRO
  BIOMASS
  GEOTHERMAL
  HYBRID
}

enum ProducerSource {
  AUTO_FEED // imported from a partner aggregator feed
  ADMIN_ADDED // manually whitelisted by admin
  SELF_ENROLLED // household signed up through the portal
}

enum ProducerCategory {
  ENERGY_PRODUCER
  EQUIPMENT_MANUFACTURER
}

enum ClaimEntityType {
  PRODUCER
  CHARGER_OPERATOR
}

// One-time email-verification token used by the producer claim flow.
// Created when a user submits the claim form with a corporate email; consumed
// on successful verification. expiresAt is 30 minutes from creation by
// convention (enforced by the application layer, not by the DB).
model ClaimToken {
  id         String          @id @default(cuid())
  token      String          @unique
  entityType ClaimEntityType
  entityId   String
  email      String
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime        @default(now())

  @@index([entityType, entityId])
  @@index([userId])
}

// EV-charging-network operator (IONITY, GreenWay, Tesla, ChargePoint, …).
// Aliases hold the variations of operator/network/brand tags from OSM data
// so a single ChargerOperator row matches all stations of that network.
model ChargerOperator {
  id          String   @id @default(cuid())
  slug        String   @unique
  displayName String
  aliases     String[] @default([])
  description String?  @db.Text
  websiteUrl  String?
  logoUrl     String?
  email       String?
  phone       String?

  // Operator-level default tariff. Travelers see this on every station whose
  // OCM `operator` string matches one of `aliases`. Step 4 will add an API
  // for operators to update this in real time; for now it's set via cabinet.
  pricePerKwh    Decimal?  @db.Decimal(8, 4)
  priceCurrency  String?   @db.VarChar(8)
  priceUpdatedAt DateTime?

  claimedById String?
  claimedBy   User?     @relation("ChargerOperatorClaims", fields: [claimedById], references: [id])
  claimedAt   DateTime?

  apiKeys ChargerOperatorApiKey[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([claimedById])
}

// API tokens that let an operator's external system push tariff updates to
// POST /api/v1/charger-operators/{id}/price. The plaintext token is shown
// to the user exactly once at creation; we only persist a SHA-256 hash.
model ChargerOperatorApiKey {
  id         String          @id @default(cuid())
  operatorId String
  operator   ChargerOperator @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  label      String // user-supplied, e.g. "Production gateway"
  tokenHash  String          @unique // SHA-256 of the plaintext token
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime        @default(now())

  @@index([operatorId])
  @@index([tokenHash])
}

// A household (or small commercial) producer that contributes battery-stored
// renewable electricity to the network.
model Producer {
  id          String  @id @default(cuid())
  slug        String  @unique
  handle      String  @unique // human-friendly id, e.g. "lisbon-rooftop-04"
  displayName String // e.g. "Casa do Sol — Lisbon"
  city        String?
  region      String?
  country     String // ISO 3166-1 alpha-2
  lat         Float?
  lng         Float?

  primarySource RenewableSource
  sourceMix     Json? // e.g. { "SOLAR": 0.7, "WIND": 0.3 }
  capacityKwh   Decimal         @db.Decimal(12, 3) // total powerbank capacity
  inverterKw    Decimal         @db.Decimal(8, 3) // max instantaneous output
  installedAt   DateTime?

  source     ProducerSource @default(SELF_ENROLLED)
  isActive   Boolean        @default(true)
  rank       Int // ranked by lifetime kWh delivered
  logoUrl    String?
  bannerUrl  String?
  bio        String?        @db.Text
  websiteUrl String?
  twitterUrl String?

  ownerId               String?
  owner                 User?            @relation("ProducerOwner", fields: [ownerId], references: [id])
  addedByAdminId        String?
  addedBy               User?            @relation("AdminProducerAdditions", fields: [addedByAdminId], references: [id])
  claimedById           String?
  claimedBy             User?            @relation("ProducerClaims", fields: [claimedById], references: [id])
  claimedAt             DateTime?
  approvedFromRequestId String?          @unique
  approvedFromRequest   ProducerRequest? @relation("ProducerRequestApproved", fields: [approvedFromRequestId], references: [id])

  category     ProducerCategory @default(ENERGY_PRODUCER)
  equipment    String[]         @default([])
  manufactures String[]         @default([])

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  metadataFetchedAt DateTime?

  snapshots      ProducerSnapshot[]
  offers         Offer[]
  contracts      Contract[]
  profile        ProducerProfile?
  producerClaims ProducerBuildRequestClaim[] @relation("ProducerClaimsByProducer")
  // Watchlist FK was dropped in V1 personal cabinet — see comment on the
  // Watchlist model. When the producer cutover lands, restore: watchedBy Watchlist[]

  @@index([claimedById])
  @@index([country, rank])
  @@index([primarySource])
}

// Rich profile data for a Producer: human-readable company info shown on the
// detail page (founded year, CEO, contact, certifications, key products).
// 1:1 with Producer; nullable so seed rows without a matching PRODUCER_PROFILES
// entry stay valid.
model ProducerProfile {
  producerId String   @id
  producer   Producer @relation(fields: [producerId], references: [id], onDelete: Cascade)

  description    String?  @db.Text
  founded        Int?
  employees      String?
  website        String?
  email          String?
  phone          String?
  address        String?
  ceo            String?
  stockTicker    String?
  certifications String[] @default([])
  keyProducts    String[] @default([])

  updatedAt DateTime @updatedAt
}

// Periodic telemetry snapshot per producer: state-of-charge, last 24h delivery, prices.
model ProducerSnapshot {
  id         String   @id @default(cuid())
  producerId String
  producer   Producer @relation(fields: [producerId], references: [id], onDelete: Cascade)

  stateOfChargePct     Float // 0..100
  availableKwh         Decimal  @db.Decimal(12, 3) // currently dischargeable
  delivered24hKwh      Decimal  @db.Decimal(12, 3)
  deliveredLifetimeKwh Decimal  @db.Decimal(16, 3)
  avgPricePerKwhUsd    Decimal  @db.Decimal(10, 6)
  pctChange24h         Float?
  pctChange7d          Float?
  uptimePct            Float?
  carbonOffsetKgCo2e   Decimal? @db.Decimal(14, 3)
  weatherCondition     String? // SUNNY/CLOUDY/WINDY/CALM…
  fetchedAt            DateTime @default(now())

  @@index([producerId, fetchedAt])
}

// Network-wide stats — analog of GlobalStats in the reference project.
model GridStats {
  id                    Int      @id @default(1)
  totalCapacityKwh      Decimal  @db.Decimal(18, 3)
  totalDelivered24hKwh  Decimal  @db.Decimal(18, 3)
  totalLifetimeKwh      Decimal  @db.Decimal(20, 3)
  activeProducers       Int
  activeHubs            Int
  solarSharePct         Float
  windSharePct          Float
  hydroSharePct         Float
  otherSharePct         Float
  carbonOffset24hKgCo2e Decimal  @db.Decimal(16, 3)
  fetchedAt             DateTime @default(now())
}

// Hub == aggregation point / microgrid / utility partner where producers and buyers meet.
model Hub {
  id               String         @id // e.g. "iberian-grid"
  slug             String         @unique
  name             String
  country          String?
  region           String?
  lat              Float?
  lng              Float?
  logoUrl          String?
  isOperational    Boolean        @default(true)
  yearEstablished  Int?
  capacityKwh      Float // aggregate
  throughput24hKwh Float
  trustScore       Int?
  trustScoreRank   Int?
  url              String?
  watchedBy        HubWatchlist[]
  contracts        Contract[]
  fetchedAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([trustScoreRank])
}

model HubWatchlist {
  userId  String
  hubId   String
  addedAt DateTime @default(now())
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hub     Hub      @relation(fields: [hubId], references: [id], onDelete: Cascade)

  @@id([userId, hubId])
  @@index([userId])
}

// V1 personal cabinet stores Producer.handle (a stable mock identifier) in
// producerId; producers themselves live in src/lib/producers.ts (mock data).
// The FK to Producer was dropped so V1 can ship without the producer-table
// cutover; a later migration will either repoint this column to a real FK
// or rename it. Until then, producerId is a free-form String key.
model Watchlist {
  userId     String
  producerId String
  addedAt    DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, producerId])
  @@index([userId])
}

enum OfferStatus {
  OPEN
  FILLED
  EXPIRED
  CANCELLED
}

// An offer to sell N kWh at price P, posted by a producer and visible on a hub.
model Offer {
  id             String      @id @default(cuid())
  producerId     String
  producer       Producer    @relation(fields: [producerId], references: [id], onDelete: Cascade)
  kwh            Decimal     @db.Decimal(12, 3)
  pricePerKwhUsd Decimal     @db.Decimal(10, 6)
  startAt        DateTime
  endAt          DateTime
  status         OfferStatus @default(OPEN)
  contracts      Contract[]
  createdAt      DateTime    @default(now())

  @@index([status, startAt])
  @@index([producerId, status])
}

enum ContractStatus {
  PENDING
  ACTIVE
  SETTLED
  CANCELLED
}

// A buyer-side contract that consumes (part of) an Offer.
model Contract {
  id             String         @id @default(cuid())
  offerId        String
  offer          Offer          @relation(fields: [offerId], references: [id], onDelete: Cascade)
  producerId     String
  producer       Producer       @relation(fields: [producerId], references: [id], onDelete: Cascade)
  buyerId        String
  buyer          User           @relation("ContractBuyer", fields: [buyerId], references: [id])
  hubId          String?
  hub            Hub?           @relation(fields: [hubId], references: [id])
  kwh            Decimal        @db.Decimal(12, 3)
  pricePerKwhUsd Decimal        @db.Decimal(10, 6)
  status         ContractStatus @default(PENDING)
  signedAt       DateTime?
  settledAt      DateTime?
  createdAt      DateTime       @default(now())

  @@index([buyerId, createdAt])
  @@index([producerId, createdAt])
  @@index([status, createdAt])
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// Household applies to list its powerbank on the platform.
model ProducerRequest {
  id               String          @id @default(cuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  handle           String
  displayName      String
  country          String
  city             String?
  primarySource    RenewableSource
  capacityKwh      Decimal         @db.Decimal(12, 3)
  inverterKw       Decimal         @db.Decimal(8, 3)
  reason           String          @db.Text
  status           RequestStatus   @default(PENDING)
  reviewedAt       DateTime?
  reviewedById     String?
  rejectReason     String?
  createdAt        DateTime        @default(now())
  reviewer         User?           @relation("RequestReviewer", fields: [reviewedById], references: [id])
  approvedProducer Producer?       @relation("ProducerRequestApproved")

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

enum AdminAction {
  APPROVE_REQUEST
  REJECT_REQUEST
  ADD_PRODUCER
  TOGGLE_PRODUCER_ACTIVE
  SET_USER_ROLE
}

enum BuildRequestSource {
  SOLAR
  WIND
  HYBRID
}

enum BuildRequestSiteType {
  PRIVATE_HOUSE
  APARTMENT_ROOF
  LAND_PLOT
  COMMERCIAL
}

enum BuildRequestRoofOrientation {
  S
  SE
  SW
  E
  W
  UNKNOWN
}

enum BuildRequestBudget {
  UNDER_5K
  FROM_5K_TO_15K
  FROM_15K_TO_30K
  FROM_30K_TO_60K
  OVER_60K
  AWAITING_QUOTE
}

enum BuildRequestTimeline {
  URGENT_1_3M
  WITHIN_YEAR
  EXPLORING
}

enum BuildRequestStatus {
  OPEN
  MATCHED
  FULFILLED
  CANCELLED
}

model AdminAuditLog {
  id         String      @id @default(cuid())
  actorId    String
  actor      User        @relation("AdminAuditActor", fields: [actorId], references: [id])
  action     AdminAction
  targetType String
  targetId   String
  details    Json?
  createdAt  DateTime    @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

model BuildRequest {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("BuildRequestOwner", fields: [userId], references: [id], onDelete: Cascade)

  source          BuildRequestSource
  peakKw          Decimal            @db.Decimal(8, 2)
  wantPowerbank   Boolean            @default(false)
  powerbankKwh    Decimal?           @db.Decimal(8, 2)
  wantEvCharger   Boolean            @default(false)
  evChargerPorts  Int?
  evPublicForSale Boolean            @default(false)

  country         String
  city            String
  addressLine     String
  lat             Float?
  lng             Float?
  siteType        BuildRequestSiteType
  availableAreaM2 Int?
  roofOrientation BuildRequestRoofOrientation?

  budget   BuildRequestBudget   @default(AWAITING_QUOTE)
  timeline BuildRequestTimeline @default(EXPLORING)
  notes    String?              @db.Text

  status            BuildRequestStatus @default(OPEN)
  adminNote         String?            @db.Text
  statusChangedAt   DateTime?
  statusChangedById String?
  statusChangedBy   User?              @relation("BuildRequestReviewer", fields: [statusChangedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  claims         BuildRequestClaim[]
  producerClaims ProducerBuildRequestClaim[] @relation("ProducerClaimsOnBR")

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([country, status])
}

// ─── Contractor Cabinet (V2a) ────────────────────────────────────────────────

enum ContractorEntityType {
  LEGAL_ENTITY
  SOLE_TRADER
  INDIVIDUAL
}

enum ContractorWorkCategory {
  DESIGN
  MANUFACTURE
  SUPPLY
  INSTALLATION
  COMMISSIONING
  MAINTENANCE
}

enum ContractorRenewableType {
  SOLAR
  WIND
  HYDRO
  BIOMASS
  GEOTHERMAL
  HYBRID
}

enum ContractorStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum ContractorMemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum EvPowerSource {
  GRID
  MIXED
  RENEWABLE_ONLY
}

enum EvConnectorType {
  CCS2
  CHAdeMO
  TYPE2
  TYPE1
  TESLA
  GB_T
  SCHUKO
}

enum EvPowerLevel {
  AC_SLOW
  AC_FAST
  DC_FAST
  DC_ULTRA
}

enum EvUsageType {
  PUBLIC
  MEMBERSHIP
  PRIVATE
  PAY_AT_LOCATION
}

enum BuildRequestClaimStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

model Contractor {
  id   String @id @default(cuid())
  slug String @unique

  entityType         ContractorEntityType
  displayName        String
  legalName          String?
  registrationNumber String?
  country            String
  city               String
  foundedYear        Int?

  workCategories  ContractorWorkCategory[]
  renewableTypes  ContractorRenewableType[]
  countriesServed String[]

  bio          String  @db.Text
  websiteUrl   String?
  logoUrl      String?
  contactEmail String
  contactPhone String

  status       ContractorStatus @default(PENDING)
  adminNote    String?          @db.Text
  reviewedAt   DateTime?
  reviewedById String?
  reviewer     User?            @relation("ContractorReviewer", fields: [reviewedById], references: [id])

  // EV charging extension
  providesEvCharging Boolean           @default(false)
  evPowerSource      EvPowerSource?
  evStationCount     Int?
  evConnectorTypes   EvConnectorType[]
  evPowerLevels      EvPowerLevel[]
  evUsageType        EvUsageType?
  evMaxPowerKw       Decimal?          @db.Decimal(6, 2)
  evDescription      String?           @db.Text

  members   ContractorMember[]
  claims    BuildRequestClaim[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([status, createdAt])
  @@index([country, status])
}

model ContractorMember {
  contractorId String
  contractor   Contractor           @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  userId       String
  user         User                 @relation("ContractorMembership", fields: [userId], references: [id], onDelete: Cascade)
  role         ContractorMemberRole @default(OWNER)
  addedAt      DateTime             @default(now())

  @@id([contractorId, userId])
  @@index([userId])
}

model BuildRequestClaim {
  id             String       @id @default(cuid())
  buildRequestId String
  buildRequest   BuildRequest @relation(fields: [buildRequestId], references: [id], onDelete: Cascade)
  contractorId   String
  contractor     Contractor   @relation(fields: [contractorId], references: [id], onDelete: Cascade)

  status  BuildRequestClaimStatus @default(PENDING)
  message String?                 @db.Text

  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  @@unique([buildRequestId, contractorId])
  @@index([buildRequestId, status])
  @@index([contractorId, status])
}

// Producer-side mirror of BuildRequestClaim.
// Lives in a parallel table (rather than polymorphic on BuildRequestClaim) so the
// existing contractor flow is untouched. Status enum is shared (BuildRequestClaimStatus).
// Eventually both tables could be unified — deferred until ChargerOperator joins (R5+).
model ProducerBuildRequestClaim {
  id             String       @id @default(cuid())
  buildRequestId String
  buildRequest   BuildRequest @relation("ProducerClaimsOnBR", fields: [buildRequestId], references: [id], onDelete: Cascade)
  producerId     String
  producer       Producer     @relation("ProducerClaimsByProducer", fields: [producerId], references: [id], onDelete: Cascade)

  status  BuildRequestClaimStatus @default(PENDING)
  message String?                 @db.Text

  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  @@unique([buildRequestId, producerId])
  @@index([buildRequestId, status])
  @@index([producerId, status])
}

// ============================================================================
// EXCHANGE CORE — listing, telemetry, token registry, order book, wallet,
// payments. Implements ТЗ §4–§8 and the analyst spec §13–§16, §19, §24.
//
// Numeric precision is fixed by ТЗ §16.1:
//   kWh    Decimal(18, 3) — 1 token = 1 kWh, stored to 0.001
//   price  Decimal(12, 4) — money per kWh
//   money  Decimal(18, 2) — fiat amounts
// Domain logic rounds to these scales via src/lib/exchange/precision.ts.
// ============================================================================

enum CompanyType {
  PRODUCER
  WHOLESALE
  COOPERATIVE
  OPERATOR
}

enum KybStatus {
  PENDING
  APPROVED
  REJECTED
}

// §4 "Проверка KYB, санкционный скрининг". What a single check looked at.
enum ScreeningKind {
  KYB // the company exists, its registration and licences are real
  SANCTIONS // consolidated sanctions and PEP lists
  ADVERSE_MEDIA
}

// §4 — the verdict the operator must have on record before approving.
enum ScreeningResult {
  CLEAR
  HIT
  INCONCLUSIVE
}

// §14: draft → submitted → approved / rejected.
enum ListingApplicationStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum AssetKind {
  SOLAR
  WIND
  BIOGAS
  HYDRO
  STORAGE
  MIXED
}

// §14: test → active after a clean telemetry period + operator approval.
enum AssetStatus {
  DRAFT
  REVIEW
  TEST
  ACTIVE
  SUSPENDED
}

// §14: received → valid / suspicious / rejected.
enum ReadingValidationStatus {
  RECEIVED
  VALID
  SUSPICIOUS
  REJECTED
}

// §14 token lifecycle. ROUTED = handed to the aggregator at interval close.
enum EnergyTokenStatus {
  AVAILABLE
  RESERVED
  STORED
  SOLD
  BURNED
  ROUTED
}

enum OrderSide {
  BUY
  SELL
}

enum OrderType {
  MARKET
  LIMIT
}

enum OrderStatus {
  NEW
  PARTIALLY_FILLED
  FILLED
  CANCELLED
  EXPIRED
  REJECTED
}

// §14: initiated → authorized → captured, with failed / refunded exits.
enum PaymentStatus {
  INITIATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

enum SettlementAccountStatus {
  ACTIVE
  FROZEN
  CLOSED
}

// §24: a transfer can require the recipient to confirm, so it has its own
// lifecycle separate from Trade.
enum TokenTransferStatus {
  CREATED
  CONFIRMED
  CANCELLED
}

// A trading zone — country or grid zone. Carries the market parameters the
// matching engine needs: tick interval, currency, spot reference and the
// price corridor of §16.5.
model GridZone {
  id              String    @id @default(cuid())
  code            String    @unique // "SK", "LT", "UA-CENTRAL"
  country         String // ISO-3166 alpha-2
  name            String
  currency        String    @default("EUR")
  // §6, §16.5 — where the spot reference comes from: null or "manual" means
  // the operator sets it by hand, "entsoe" means the day-ahead feed.
  spotSource      String?
  // The bidding zone at the source, e.g. the EIC code 10YSK-SEPS---K.
  spotAreaCode    String?
  intervalMinutes Int       @default(15) // §18 open question: 15 or 60
  // §16.5 — trade price must stay within ±corridorPct of spotPrice.
  corridorPct     Decimal   @default(20) @db.Decimal(5, 2)
  spotPrice       Decimal?  @db.Decimal(12, 4)
  spotPriceAt     DateTime?
  // §16.4 — where unsold tokens go when an interval closes.
  aggregatorName  String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  assets    Asset[]
  tokens    EnergyToken[]
  wallets   Wallet[]
  orders    Order[]
  trades    Trade[]
  payments  Payment[]
  transfers TokenTransfer[]
  readings  MeterReading[]

  cooperatives         Cooperative[]
  spotPrices           ZoneSpotPrice[]
  roamingAsHomeZone    RoamingAgreement[] @relation("RoamingHomeZone")
  roamingAsVisitedZone RoamingAgreement[] @relation("RoamingVisitedZone")
}

// §6, §16.5 — the external spot reference per interval, kept as history.
// The corridor reads the current one; §16.7 (no liquidity on the exchange)
// settles at the one that applied, so an overwritten number is not enough.
model ZoneSpotPrice {
  id            String   @id @default(cuid())
  zoneId        String
  zone          GridZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  intervalStart DateTime
  // EUR per kWh, converted from the source's EUR per MWh.
  price         Decimal  @db.Decimal(12, 4)
  currency      String   @default("EUR")
  source        String
  fetchedAt     DateTime @default(now())

  @@unique([zoneId, intervalStart, source])
  @@index([zoneId, intervalStart])
}

// §13 Company — the legal entity that lists on the platform. Distinct from
// Contractor (a build-services vendor) and Producer (a public catalogue card).
model Company {
  id            String      @id @default(cuid())
  legalName     String
  country       String // ISO-3166 alpha-2
  regNumber     String
  vatNumber     String?
  type          CompanyType
  kybStatus     KybStatus   @default(PENDING)
  // Sanctions screening result, filled by the operator during review.
  screeningNote String?     @db.Text
  website       String?
  contactName   String?
  contactEmail  String?
  contactPhone  String?
  ownerUserId   String?
  owner         User?       @relation("CompanyOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  applications      ListingApplication[]
  screenings        ScreeningCheck[]
  assets            Asset[]
  settlementAccount SettlementAccount?
  feePlanId         String?
  feePlan           FeePlan?             @relation(fields: [feePlanId], references: [id], onDelete: SetNull)
  cooperative       Cooperative?

  @@unique([country, regNumber])
  @@index([type, kybStatus])
}

// §13 / US-01, US-02. Documents are stored as a JSON array of
// { name, url, bytes, mime } — upload target is out of scope for this slice.
model ListingApplication {
  id              String                   @id @default(cuid())
  companyId       String
  company         Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  status          ListingApplicationStatus @default(DRAFT)
  documents       Json                     @default("[]")
  reviewerId      String?
  reviewer        User?                    @relation("ListingReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  decisionComment String?                  @db.Text
  submittedAt     DateTime?
  decidedAt       DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@index([status, submittedAt])
  @@index([companyId])
}

// §4 / US-02 — one KYB or sanctions check on a company.
//
// Who ran the check matters as much as the verdict: an operator typing in what
// the national register and the EU consolidated list said is a different
// record from an automated provider's answer, and a regulator will ask which
// it was. `provider` says so, `evidence` keeps the references, and the row is
// immutable once written — a re-check is a new row.
model ScreeningCheck {
  id          String          @id @default(cuid())
  companyId   String
  company     Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  kind        ScreeningKind
  result      ScreeningResult
  /// "manual" while no provider is contracted; otherwise the provider's name.
  provider    String
  /// Registry extract numbers, list names, search URLs — what was looked at.
  evidence    String?         @db.Text
  /// Matches the check turned up, as the provider reported them.
  matches     Json            @default("[]")
  checkedById String?
  checkedBy   User?           @relation("ScreeningChecker", fields: [checkedById], references: [id], onDelete: SetNull)
  checkedAt   DateTime        @default(now())

  @@index([companyId, kind, checkedAt])
}

// §13 Asset — a generation object or a storage unit (powerbank).
model Asset {
  id               String      @id @default(cuid())
  companyId        String
  company          Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  kind             AssetKind
  name             String
  capacityKw       Decimal     @db.Decimal(12, 3)
  storageKwh       Decimal?    @db.Decimal(12, 3) // capacity, STORAGE/MIXED only
  storedKwh        Decimal     @default(0) @db.Decimal(18, 3) // current charge
  address          String?
  latitude         Float?
  longitude        Float?
  gridZoneId       String
  gridZone         GridZone    @relation(fields: [gridZoneId], references: [id])
  meterId          String?     @unique
  status           AssetStatus @default(DRAFT)
  goCertificateRef String? // guarantee of origin registry reference

  // §4: token minting stays off until documents pass AND telemetry has run
  // clean for the probation window. telemetryCleanSince is reset by any
  // SUSPICIOUS/REJECTED reading.
  telemetryCleanSince DateTime?
  activatedAt         DateTime?
  suspendedReason     String?

  // §30 "Правила продажи" — the dispatcher splits each validated interval.
  minSalePrice      Decimal? @db.Decimal(12, 4)
  shareToMarketPct  Int      @default(100)
  shareToStoragePct Int      @default(0)
  shareToSelfPct    Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  apiKeys  AssetApiKey[]
  readings MeterReading[]
  tokens   EnergyToken[]

  @@index([companyId, status])
  @@index([gridZoneId, status])
}

// Telemetry credential for one asset. Mirrors ChargerOperatorApiKey: the
// plaintext is shown once, only the SHA-256 is stored.
model AssetApiKey {
  id         String    @id @default(cuid())
  assetId    String
  asset      Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  label      String?
  tokenHash  String    @unique
  prefix     String // first chars of the plaintext, for display
  // §15 HMAC signing secret, sealed with API_KEY_ENC_KEY (src/lib/crypto-box.ts).
  // Null on keys issued before signing existed, or where no key is configured:
  // those keep working unsigned until they are rotated.
  signingSecretEnc String?
  signingSecretIv  String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  @@index([assetId])
}

// §5 / §13. One reading per (asset, interval) — this uniqueness is what
// guarantees §16.2 "one MeterReading → exactly one mint".
model MeterReading {
  id               String                  @id @default(cuid())
  assetId          String
  asset            Asset                   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  zoneId           String
  zone             GridZone                @relation(fields: [zoneId], references: [id])
  intervalStart    DateTime
  intervalEnd      DateTime
  energyKwh        Decimal                 @db.Decimal(18, 3)
  source           String // "rest" | "mqtt" | "manual"
  validationStatus ReadingValidationStatus @default(RECEIVED)
  validationNote   String?
  receivedAt       DateTime                @default(now())
  mintedAt         DateTime?

  token EnergyToken?

  @@unique([assetId, intervalStart])
  @@index([assetId, intervalStart])
  @@index([validationStatus])
}

// §5 / §13 Token — a batch of kWh. A batch splits when a trade consumes part
// of it, so amountKwh is always the live, unconsumed size of the batch.
model EnergyToken {
  id               String            @id @default(cuid())
  assetId          String
  asset            Asset             @relation(fields: [assetId], references: [id], onDelete: Cascade)
  zoneId           String
  zone             GridZone          @relation(fields: [zoneId], references: [id])
  // Set on the batch minted directly from a reading; null on split children
  // and on batches created by storage round-trips.
  readingId        String?           @unique
  reading          MeterReading?     @relation(fields: [readingId], references: [id], onDelete: SetNull)
  parentId         String?
  parent           EnergyToken?      @relation("TokenSplit", fields: [parentId], references: [id], onDelete: SetNull)
  children         EnergyToken[]     @relation("TokenSplit")
  intervalStart    DateTime
  amountKwh        Decimal           @db.Decimal(18, 3)
  status           EnergyTokenStatus @default(AVAILABLE)
  goCertificateRef String?
  ownerWalletId    String?
  ownerWallet      Wallet?           @relation(fields: [ownerWalletId], references: [id], onDelete: SetNull)
  // §16.4 routing outcome, when status = ROUTED or STORED.
  routedTo         String?
  storedInAssetId  String?
  mintedAt         DateTime          @default(now())
  burnedAt         DateTime?

  @@index([assetId, intervalStart])
  @@index([zoneId, status, intervalStart])
  @@index([ownerWalletId, status])
}

// §7 Wallet — one per (user, zone): kWh tokens plus a fiat balance.
model Wallet {
  id           String   @id @default(cuid())
  ownerUserId  String
  owner        User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  zoneId       String
  zone         GridZone @relation(fields: [zoneId], references: [id])
  kwhBalance   Decimal  @default(0) @db.Decimal(18, 3)
  fiatBalance  Decimal  @default(0) @db.Decimal(18, 2)
  // Funds held against open BUY orders (§12 US-06 "резерв средств").
  reservedFiat Decimal  @default(0) @db.Decimal(18, 2)
  currency     String   @default("EUR")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tokens            EnergyToken[]
  orders            Order[]
  payments          Payment[]
  outgoingTransfers TokenTransfer[] @relation("TransferFrom")
  incomingTransfers TokenTransfer[] @relation("TransferTo")

  @@unique([ownerUserId, zoneId])
  @@index([zoneId])
}

// §6 / §13 Order. MARKET orders never rest in the book; only LIMIT orders do.
model Order {
  id             String      @id @default(cuid())
  walletId       String
  wallet         Wallet      @relation(fields: [walletId], references: [id], onDelete: Cascade)
  zoneId         String
  zone           GridZone    @relation(fields: [zoneId], references: [id])
  side           OrderSide
  type           OrderType
  intervalStart  DateTime? // null = any interval (spot / retail buy)
  amountKwh      Decimal     @db.Decimal(18, 3)
  filledKwh      Decimal     @default(0) @db.Decimal(18, 3)
  limitPrice     Decimal?    @db.Decimal(12, 4)
  avgPrice       Decimal?    @db.Decimal(12, 4)
  status         OrderStatus @default(NEW)
  reservedFiat   Decimal     @default(0) @db.Decimal(18, 2)
  rejectReason   String?
  // §15: every POST carries an idempotency key.
  idempotencyKey String?     @unique
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  cancelledAt    DateTime?

  buyTrades  Trade[]  @relation("BuyOrder")
  sellTrades Trade[]  @relation("SellOrder")
  payment    Payment? @relation("PaymentOrder")

  // The resting-book query: open orders of one side, in a zone and interval.
  @@index([zoneId, intervalStart, side, status, limitPrice, createdAt])
  @@index([walletId, status])
}

// §13 Trade — one fill. Fees are charged to both sides per §16.8.
model Trade {
  id          String   @id @default(cuid())
  zoneId      String
  zone        GridZone @relation(fields: [zoneId], references: [id])
  buyOrderId  String
  buyOrder    Order    @relation("BuyOrder", fields: [buyOrderId], references: [id], onDelete: Cascade)
  sellOrderId String
  sellOrder   Order    @relation("SellOrder", fields: [sellOrderId], references: [id], onDelete: Cascade)
  amountKwh   Decimal  @db.Decimal(18, 3)
  price       Decimal  @db.Decimal(12, 4)
  buyerFee    Decimal  @default(0) @db.Decimal(18, 2)
  sellerFee   Decimal  @default(0) @db.Decimal(18, 2)
  executedAt  DateTime @default(now())

  receipt Receipt?

  @@index([zoneId, executedAt])
  @@index([buyOrderId])
  @@index([sellOrderId])
}

// §8 Payment — the charge waterfall: balance first, shortfall bought at market.
model Payment {
  id             String        @id @default(cuid())
  walletId       String
  wallet         Wallet        @relation(fields: [walletId], references: [id], onDelete: Cascade)
  zoneId         String
  zone           GridZone      @relation(fields: [zoneId], references: [id])
  chargePointId  String?
  requestedKwh   Decimal       @db.Decimal(18, 3)
  kwhFromBalance Decimal       @default(0) @db.Decimal(18, 3)
  kwhBought      Decimal       @default(0) @db.Decimal(18, 3)
  // Authorized with the §16.6 buffer; captured at the real execution price.
  authorizedFiat Decimal       @default(0) @db.Decimal(18, 2)
  amountFiat     Decimal       @default(0) @db.Decimal(18, 2)
  status         PaymentStatus @default(INITIATED)
  failureReason  String?
  cardId         String?
  marketOrderId  String?       @unique
  marketOrder    Order?        @relation("PaymentOrder", fields: [marketOrderId], references: [id], onDelete: SetNull)
  idempotencyKey String?       @unique
  createdAt      DateTime      @default(now())
  authorizedAt   DateTime?
  capturedAt     DateTime?

  receipt Receipt?

  @@index([walletId, createdAt])
  @@index([status])
}

// §13 / §46 Receipt — issued for a payment or a trade; lists the burned batches.
model Receipt {
  id             String   @id @default(cuid())
  paymentId      String?  @unique
  payment        Payment? @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  tradeId        String?  @unique
  trade          Trade?   @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  burnedTokenIds String[]
  totalKwh       Decimal  @default(0) @db.Decimal(18, 3)
  totalFiat      Decimal  @default(0) @db.Decimal(18, 2)
  currency       String   @default("EUR")
  // §46 "Состав чека" — per-line detail kept verbatim for accounting export.
  breakdown      Json     @default("{}")
  issuedAt       DateTime @default(now())

  @@index([issuedAt])
}

// §19 US-13 — personal IBAN opened after listing approval. Named
// SettlementAccount because `Account` is taken by the Auth.js adapter.
model SettlementAccount {
  id        String                  @id @default(cuid())
  companyId String?                 @unique
  company   Company?                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String?                 @unique
  user      User?                   @relation("UserSettlementAccount", fields: [userId], references: [id], onDelete: Cascade)
  iban      String                  @unique
  bic       String?
  currency  String                  @default("EUR")
  balance   Decimal                 @default(0) @db.Decimal(18, 2)
  status    SettlementAccountStatus @default(ACTIVE)
  openedAt  DateTime                @default(now())

  entries SettlementEntry[]
}

// Statement line for GET /v1/accounts/{id}/statement.
model SettlementEntry {
  id          String            @id @default(cuid())
  accountId   String
  account     SettlementAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  amount      Decimal           @db.Decimal(18, 2) // signed
  currency    String            @default("EUR")
  description String
  reference   String? // trade / payment / payout id
  bookedAt    DateTime          @default(now())

  @@index([accountId, bookedAt])
}

// §24 — kWh handoff between members inside one zone.
model TokenTransfer {
  id           String              @id @default(cuid())
  zoneId       String
  zone         GridZone            @relation(fields: [zoneId], references: [id])
  fromWalletId String
  fromWallet   Wallet              @relation("TransferFrom", fields: [fromWalletId], references: [id], onDelete: Cascade)
  toWalletId   String
  toWallet     Wallet              @relation("TransferTo", fields: [toWalletId], references: [id], onDelete: Cascade)
  amountKwh    Decimal             @db.Decimal(18, 3)
  note         String?
  status       TokenTransferStatus @default(CONFIRMED)
  // §15, same second line of defence as Order and Payment carry.
  idempotencyKey String?           @unique
  createdAt    DateTime            @default(now())
  confirmedAt  DateTime?
  cancelledAt  DateTime?

  @@index([fromWalletId, createdAt])
  @@index([toWalletId, createdAt])
}

// §16.8 / §53 — platform commission, configured per participant type.
model FeePlan {
  id              String       @id @default(cuid())
  name            String       @unique
  participantType CompanyType?
  tradeFeePct     Decimal      @default(1) @db.Decimal(5, 2)
  chargeFeePct    Decimal      @default(2) @db.Decimal(5, 2)
  isDefault       Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  companies Company[]
}

// §16.11 — generic audit trail for every balance and status change.
// AdminAuditLog stays as-is for the moderation cabinet; this one is written
// by the exchange services and keyed by entity rather than by actor.
model AuditLog {
  id       String   @id @default(cuid())
  actor    String // user id, "system", or "asset:<id>"
  entity   String // "Order", "Wallet", "EnergyToken", …
  entityId String
  action   String
  before   Json?
  after    Json?
  at       DateTime @default(now())

  @@index([entity, entityId, at])
  @@index([at])
}

// ---------------------------------------------------------------------------
// Cooperatives and roaming — ТЗ §7, §8 "Роуминг", §16.10, §24, US-10/11/21.
// ---------------------------------------------------------------------------

// §24.1 — only a KYC-verified member may use or sell received kWh, so
// membership carries its own status instead of relying on the Company KYB.
enum CoopMemberStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum CoopVoteStatus {
  OPEN
  CLOSED
}

// §2 "Кооператив — владелец накопителей (пауэрбанков)". The legal entity is a
// Company of type COOPERATIVE; this model adds the membership, income and
// governance layer on top of it.
model Cooperative {
  id        String   @id @default(cuid())
  companyId String   @unique
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  zoneId    String
  zone      GridZone @relation(fields: [zoneId], references: [id])
  name      String
  // Shares are issued, not derived: a member's stake does not change when
  // another member joins.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members CoopMember[]
  payouts CoopPayout[]
  votes   CoopVote[]

  @@index([zoneId])
}

// US-10 — "количество паёв, доход за период, история выплат".
model CoopMember {
  id            String           @id @default(cuid())
  coopId        String
  coop          Cooperative      @relation(fields: [coopId], references: [id], onDelete: Cascade)
  userId        String
  user          User             @relation("CoopMembership", fields: [userId], references: [id], onDelete: Cascade)
  shares        Int              @default(0)
  status        CoopMemberStatus @default(PENDING)
  kycVerifiedAt DateTime?
  joinedAt      DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  allocations CoopPayoutAllocation[]
  ballots     CoopBallot[]

  @@unique([coopId, userId])
  @@index([coopId, status])
}

// §16.10 — one income period, split pro rata by shares. The split is stored
// rather than recomputed so a later share change cannot rewrite history.
model CoopPayout {
  id           String      @id @default(cuid())
  coopId       String
  coop         Cooperative @relation(fields: [coopId], references: [id], onDelete: Cascade)
  periodStart  DateTime
  periodEnd    DateTime
  incomeAmount Decimal     @db.Decimal(18, 2)
  currency     String      @default("EUR")
  totalShares  Int
  note         String?
  createdAt    DateTime    @default(now())

  allocations CoopPayoutAllocation[]

  @@unique([coopId, periodStart, periodEnd])
  @@index([coopId, periodStart])
}

model CoopPayoutAllocation {
  id       String     @id @default(cuid())
  payoutId String
  payout   CoopPayout @relation(fields: [payoutId], references: [id], onDelete: Cascade)
  memberId String
  member   CoopMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  shares   Int
  amount   Decimal    @db.Decimal(18, 2)
  paidAt   DateTime?

  @@unique([payoutId, memberId])
  @@index([memberId])
}

// US-21 — "один член, один голос; результаты видны после закрытия голосования".
model CoopVote {
  id        String         @id @default(cuid())
  coopId    String
  coop      Cooperative    @relation(fields: [coopId], references: [id], onDelete: Cascade)
  question  String
  options   String[]
  status    CoopVoteStatus @default(OPEN)
  opensAt   DateTime       @default(now())
  closesAt  DateTime
  closedAt  DateTime?
  // Filled on close; null means a tie or no ballots.
  winner    String?
  createdAt DateTime       @default(now())

  ballots CoopBallot[]

  @@index([coopId, status])
}

// The unique constraint is the "one member, one vote" rule in the schema:
// changing a vote updates the row, it never adds one.
model CoopBallot {
  id        String     @id @default(cuid())
  voteId    String
  vote      CoopVote   @relation(fields: [voteId], references: [id], onDelete: Cascade)
  memberId  String
  member    CoopMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  option    String
  castAt    DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([voteId, memberId])
}

// §8 "Роуминг" — the clearing corridor between two zones. Directional: the
// partner's fee for spending SK-bought kWh in LT need not match the reverse.
model RoamingAgreement {
  id            String   @id @default(cuid())
  homeZoneId    String
  homeZone      GridZone @relation("RoamingHomeZone", fields: [homeZoneId], references: [id], onDelete: Cascade)
  visitedZoneId String
  visitedZone   GridZone @relation("RoamingVisitedZone", fields: [visitedZoneId], references: [id], onDelete: Cascade)
  partnerName   String
  feePct        Decimal  @default(0) @db.Decimal(5, 2)
  enabled       Boolean  @default(true)
  // §24.2 — AML limit per user per day, null = no cap configured.
  dailyLimitKwh Decimal? @db.Decimal(18, 3)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([homeZoneId, visitedZoneId])
  @@index([visitedZoneId])
}

// §15 — "Все POST-запросы с ключом идемпотентности". One row per
// (endpoint, caller, key): the stored response is replayed verbatim, so a
// retried payment or order cannot become a second one. `status = 0` marks a
// request still in flight; see src/lib/exchange/idempotency.ts.
model IdempotencyRecord {
  id          String   @id @default(cuid())
  endpoint    String
  key         String
  // The caller: user id for session endpoints, api key id for equipment.
  userKey     String
  requestHash String
  status      Int      @default(0)
  response    Json     @default("{}")
  createdAt   DateTime @default(now())
  completedAt DateTime?

  @@unique([endpoint, userKey, key])
  @@index([createdAt])
}

// §16.11 — "реестр токенов сверяется с данными сети раз в сутки". One row per
// run, so the operator can see that the check ran at all, and what it found.
// Drifts are never repaired automatically: each one is a bug upstream.
model ReconciliationRun {
  id         String    @id @default(cuid())
  scope      String    @default("daily")
  windowFrom DateTime
  windowTo   DateTime
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  // Per check: how much was compared and every disagreement found.
  checks     Json      @default("[]")
  driftCount Int       @default(0)
  ok         Boolean   @default(true)

  @@index([startedAt])
}
